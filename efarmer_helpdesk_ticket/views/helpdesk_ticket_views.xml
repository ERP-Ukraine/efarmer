<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="helpdesk_ticket_view_form_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/.." position="after">
                <field name="use_short_form" invisible="1"/>
                <button name="action_short_form"
                        string="Fill the form"
                        type="object"
                        class="btn btn-primary text-uppercase"
                        invisible="not use_short_form"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">use_short_form</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">use_short_form</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_phone']" position="attributes">
                <attribute name="readonly">use_short_form</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='sale_order_id']" position="attributes">
                <attribute name="readonly">use_short_form</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="scheduled_date" invisible="not use_short_form"/>
            </xpath>
            <xpath expr="//field[@name='priority']" position="after">
                 <field name="returned_amount" invisible="not use_short_form"/>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="allowed_tag_ids" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_tag_ids)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_stock_ticket_view_form_inherit" model="ir.ui.view">
        <field name="name">helpdesk.stock.ticket.view.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_stock.helpdesk_ticket_view_form_inherit_helpdesk_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_id']" position="after">
                <field name="product_id" readonly="use_short_form" invisible="not (use_credit_notes or use_product_returns or use_product_repairs)" force_save="1"/>
                <field name="lot_id" groups="stock.group_stock_user" readonly="use_short_form" invisible="(tracking in ['none', False]) or (not use_credit_notes and not use_product_returns and not use_product_repairs)" force_save="1"/>
            </xpath>
            
            <xpath expr="//field[@name='tracking']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='priority']" position="after">
                <field name="delivery_transfer_id" readonly="use_short_form"/>
                <field name="delivery_move_id" readonly="use_short_form"/>
            </xpath>
            <xpath expr="//field[@name='description']" position="after">
                <label for="note"/>
                <field name="note" widget="text"/>
            </xpath>
        </field>
    </record>

    <record id="helpdesk_tickets_view_tree_inherit" model="ir.ui.view">
        <field name='name'>helpdesk.ticket.form.inherit</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="before">
                <field name="scheduled_date" optional="hide"/>
                <field name="returned_amount" optional="hide"/>
            </xpath>
        </field>
    </record>


</odoo>
