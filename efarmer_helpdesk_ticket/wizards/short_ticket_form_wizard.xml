<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="short_ticket_wizard_view_form" model="ir.ui.view">
    <field name="name">short.ticket.wizard.view.form</field>
    <field name="model">short.ticket.form.wizard</field>
    <field name="arch" type="xml">
        <form>
            <sheet>
                <group name="related-fields">
                    <group>
                        <field name="ticket_id" invisible="1"/>
                        <field name="allowed_tag_ids" invisible="1" widget="many2many_tags"/>
                        <field name="choose_product_by" widget="radio"/>
                        <field name="lot_id" options="{'no_create': True}"/>
                        <field name="product_id" readonly="choose_product_by == 'serial'" force_save="1"/>
                        <field name="partner_id" readonly="choose_product_by == 'serial'" force_save="1"/>
                        <field name="sale_id" readonly="choose_product_by == 'serial'" force_save="1"/>
                        <field name="delivery_transfer_id" readonly="choose_product_by == 'serial'" force_save="1"/>
                        <field name="delivery_move_id" readonly="choose_product_by == 'serial'" force_save="1"/>
                        <field name="efarmer_client_type" readonly="choose_product_by == 'serial'" force_save="1"/>
                        <field name="email" readonly="choose_product_by == 'serial'" force_save="1"/>
                        <field name="phone" readonly="choose_product_by == 'serial'" force_save="1"/>
                        <field name="tag_ids" domain="[('id', 'in', allowed_tag_ids)]" options="{'no_create': True}" widget="many2many_tags"/>
                    </group>
                </group>
                <label for="note"/>
                <field name="note" widget="text"/>
            </sheet>
            <footer>
                <button string="Complete" name="action_run" type="object" class="btn-primary"/>
                <button string="Cancel" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

<record id="short_ticket_action_view_form" model="ir.actions.act_window">
    <field name="name">Short Ticket Form</field>
    <field name="res_model">short.ticket.form.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="short_ticket_wizard_view_form"/>
    <field name="target">new</field>
</record>

</odoo>
