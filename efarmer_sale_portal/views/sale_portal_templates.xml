<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <template id="sale_order_portal_content_inherit" name="Delivery date Portal"
             inherit_id="sale.sale_order_portal_content">
       <xpath expr="//div[@id='so_date']" position="after">
           <div class="row" id="so_pick_scheduled_date">
               <div class="mb-3 col-6">
                   <t t-if="sale_order.pick_scheduled_date">
                       <strong>Delivery Date:</strong>
                   </t>
                   <span t-field="sale_order.pick_scheduled_date" t-options='{"widget": "date"}'/>
               </div>
           </div>
       </xpath>
   </template>
    <template id="sale_order_portal_template_inherit" name="Spline adapter notification"
              inherit_id="sale.sale_order_portal_template">
        <xpath expr="//div[@t-if='sale_order.is_expired']" position="before">
            <div t-if="any([name.startswith('Spline adapter') for name in sale_order.activity_ids.mapped('activity_type_id').mapped('name')])"
                 class="alert alert-danger alert-dismissable d-print-none" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="close">×</button>
                <strong>To ensure timely processing and shipping of your order,
                    please provide this information by filling out the form here:
                </strong>
                <a target="_blank" href="https://tech.fieldbee.com">LINK</a>
            </div>
        </xpath>
    </template>

    <template id="portal_my_home_menu_sale_tmpl_inherit" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//ol[contains(@class, 'o_portal_submenu')]/li[1]" position="attributes">
            <attribute name="t-if">page_name == 'quote' or sale_order and sale_order.state in ('sent', 'cancel', 'to_payment', 'to_confirm')</attribute>
        </xpath>
    </template>
</odoo>
