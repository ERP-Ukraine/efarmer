<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <template id="sale_order_portal_content_inherit" name="Delivery date Portal"
             inherit_id="sale.sale_order_portal_content">
       <xpath expr="//div[@id='so_date']" position="after">
           <div class="row" id="so_pick_scheduled_date">
               <div class="mb-3 col-6">
                   <t t-if="sale_order.pick_scheduled_date">
                       <strong>Delivery Date:</strong>
                   </t>
                   <span t-field="sale_order.pick_scheduled_date" t-options='{"widget": "date"}'/>
               </div>
           </div>
       </xpath>
   </template>
</odoo>
