<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record model="ir.actions.server" id="action_invoice_check_whitelist_bank_account">
        <field name="name">Validate Bank Account (whitelist)</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">
            action = records.x_wl_action_validate_bank_account()
        </field>
    </record>

    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">view_move_form_inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='button_draft']" position="after">
                <button name="x_wl_action_validate_bank_account" string="Check Bank Account" type="object"
                        class="oe_highlight"
                        context="{'no_confirm': True}" invisible="not partner_bank_id"/>
            </xpath>
        </field>
    </record>

</odoo>
