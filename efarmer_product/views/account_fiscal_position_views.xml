<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_position_form_efarmer_product_inherit" model="ir.ui.view">
        <field name="name">view.account.position.form.efarmer.product.inherit</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_src_id']" position="before">
                <field name="product_func_id"/>
                <field name="product_vat_id"/>
            </xpath>
        </field>
    </record>

</odoo>
