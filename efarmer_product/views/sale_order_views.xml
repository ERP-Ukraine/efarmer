<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_efarmer_product_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.efarmer.product.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fiscal_position_id']/.." position="after">
                <field name="is_auto_calc_taxes"/>
                <field name="helpdesk_ticket_count" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_preview_sale_order']" position="before">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_helpdesk_tickets"
                        icon="fa-life-ring"
                        invisible="helpdesk_ticket_count == 0">
                    <div class="o_stat_info">
                        <field name="helpdesk_ticket_count" class="o_stat_value"/>
                        <span class="o_stat_text"> Tickets</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="product_vat_id" string="VAT ID"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="after">
                <button name="action_propagate_tax_id"
                        type="object"
                        icon="fa-share-square-o"
                        title="Copy this line's taxes to all other order lines and remove any other taxes from them"
                        class="btn-link"
                        column_invisible="parent.is_auto_calc_taxes"
                        invisible="display_type or is_downpayment or qty_invoiced > 0"/>
            </xpath>
        </field>
    </record>
</odoo>
