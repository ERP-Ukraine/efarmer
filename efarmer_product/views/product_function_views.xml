<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_function_form" model="ir.ui.view">
        <field name="name">view.product.function.form</field>
        <field name="model">product.function</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_function_tree" model="ir.ui.view">
        <field name="name">view.product.function.tree</field>
        <field name="model">product.function</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_product_function_form">
        <field name="name">Product Function</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.function</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_product_function"
              parent="stock.menu_product_in_config_stock"
              action="action_product_function_form"
              sequence="51"
              groups="base.group_user"/>

</odoo>
