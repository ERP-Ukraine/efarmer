<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_efarmer_product_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.efarmer.product.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='sell_purchase_uom']" position="after">
                <setting id="default_product_function_settings"
                     help="Set Fully Invoiced for Upselling Opportunity Sales Orders"   >
                    <group class="mt16">
                        <field name="product_function_id"/>
                    </group>
                </setting>
            </xpath>
        </field>
    </record>
    <record id="res_config_settings_view_form_account" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='tax_fiscal_country_234']" position="after">
                <setting id="enable_so_tax_auto_calc" >
                    <field name="enable_so_tax_auto_calc"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
