<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="efarmer_helpdesk_repair_view_form" model="ir.ui.view">
    <field name="name">efarmer.helpdesk.repair.view.form</field>
    <field name="model">efarmer.helpdesk.repair</field>
    <field name="arch" type="xml">
        <form>
            <sheet>

                <group name="related-fields">
                    <group>
                        <field name="ticket_id"/>
                        <field name="product_id"/>

                        <field name="product_tracking" invisible="1"/>
                        <field name="lot_id" attrs="{'required': [('product_tracking', 'in', ['lot', 'serial'])]}"/>
                    </group>
                </group>

                <h3>1. Setup basic fields.</h3>

                <group name="basic-fields">
                    <field name="operation_type"/>
                    <field name="should_go_through_transit_warehouse"/>
                </group>

                <div name="path-wrapper" class="mt8">
                    <h3>2. Set up blank fields.</h3>
                    <span class="text-muted">* If you don't want to use a transit warehouse, just leave the field blank.</span>

                    <h4 class="mt16 ml16">Send the device from the customer to the factory...</h4>
                    <div name="customer-factory-path" class="d-flex">
                        <div class="col-4">
                            <label for="customer_location_id" string="Customer"/>
                            <i class="fa fa-arrow-right"/><br/>
                            <field name="customer_location_id"/>
                        </div>
                        <div class="col-4" attrs="{'invisible': [('should_go_through_transit_warehouse', '=', False)]}">
                            <label for="return_warehouse_id" string="Transit"/>
                            <i class="fa fa-arrow-right"/><br/>
                            <field name="return_warehouse_id" attrs="{'required': [('operation_type', '=', 'repair_replace_return')]}"/>
                        </div>
                        <div class="col-4">
                            <label for="factory_id" string="Factory"/>
                            <br/>
                            <field name="factory_id"/>
                        </div>
                    </div>

                    <div attrs="{'invisible': [('operation_type', 'not in', ('repair_replace', 'repair_replace_return'))]}">
                        <h4 class="mt16 ml16">Send the replacement product to the customer from the Used warehouse...</h4>
                        <div name="used-customer-path" class="d-flex">
                            <div class="col-4">
                                <label for="used_warehouse_id" string="Used Warehouse"/>
                                <i class="fa fa-arrow-right"/><br/>
                                <field name="used_warehouse_id"
                                    attrs="{'required': [('operation_type', 'in', ('repair_replace', 'repair_replace_return'))]}"/>
                            </div>
                            <div class="col-4" attrs="{'invisible': [('should_go_through_transit_warehouse', '=', False), ('operation_type', '!=', 'repair_replace_return')]}">
                                <label for="return_warehouse_id" string="Transit"/>
                                <i class="fa fa-arrow-right"/><br/>
                                <field name="return_warehouse_id" attrs="{'required': [('operation_type', '=', 'repair_replace_return')]}"/>
                            </div>
                            <div class="col-4">
                                <label for="customer_location_id" string="Customer"/>
                                <br/>
                                <field name="customer_location_id"/>
                            </div>
                        </div>
                    </div>

                    <div attrs="{'invisible': [('operation_type', '!=', 'repair_replace')]}">
                        <h4 class="mt16 ml16">Store the repaired device on a company warehouse...</h4>
                        <div name="factory-warehouse-path" class="d-flex">
                            <div class="col-4">
                                <label for="factory_id" string="Factory"/>
                                <i class="fa fa-arrow-right"/><br/>
                                <field name="factory_id"/>
                            </div>
                            <div class="col-4" attrs="{'invisible': [('should_go_through_transit_warehouse', '=', False)]}">
                                <label for="return_warehouse_id" string="Transit"/>
                                <i class="fa fa-arrow-right"/><br/>
                                <field name="return_warehouse_id" attrs="{'required': [('operation_type', '=', 'repair_replace_return')]}" options="{'no_create': True}"/>
                            </div>
                            <div class="col-4">
                                <label for="stock_warehouse_id" string="Company Warehouse"/>
                                <br/>
                                <field name="stock_warehouse_id"
                                    attrs="{'required': [('operation_type', '=', 'repair_replace')]}"/>
                            </div>
                        </div>
                    </div>

                    <div attrs="{'invisible': [('operation_type', 'not in', ('repair', 'repair_replace_return'))]}">
                        <h4 class="mt16 ml16">Send the repaired device back to the customer from the factory...</h4>
                        <div name="factory-customer-path" class="d-flex">
                            <div class="col-4">
                                <label for="factory_id" string="Factory"/>
                                <i class="fa fa-arrow-right"/><br/>
                                <field name="factory_id"/>
                            </div>
                            <div class="col-4" attrs="{'invisible': [('should_go_through_transit_warehouse', '=', False)]}">
                                <label for="return_warehouse_id" string="Transit"/>
                                <i class="fa fa-arrow-right"/><br/>
                                <field name="return_warehouse_id" attrs="{'required': [('operation_type', '=', 'repair_replace_return')]}" options="{'no_create': True}"/>
                            </div>
                            <div class="col-4">
                                <label for="customer_location_id" string="Customer"/>
                                <br/>
                                <field name="customer_location_id"/>
                            </div>
                        </div>
                    </div>

                    <div attrs="{'invisible': [('operation_type', '!=', 'repair_replace_return')]}">
                        <h4 class="mt16 ml16">Get back the replacement product...</h4>
                        <div name="customer-warehouse-path" class="d-flex">
                            <div class="col-4">
                                <label for="customer_location_id" string="Customer"/>
                                <i class="fa fa-arrow-right"/><br/>
                                <field name="customer_location_id"/>
                            </div>
                            <div class="col-4" attrs="{'invisible': [('should_go_through_transit_warehouse', '=', False), ('operation_type', '!=', 'repair_replace_return')]}">
                                <label for="return_warehouse_id" string="Transit"/>
                                <i class="fa fa-arrow-right"/><br/>
                                <field name="return_warehouse_id" attrs="{'required': [('operation_type', '=', 'repair_replace_return')]}"/>
                            </div>
                            <div class="col-4">
                                <label for="used_warehouse_id" string="Used Warehouse"/>
                                <br/>
                                <field name="used_warehouse_id"
                                    attrs="{'required': [('operation_type', 'in', ('repair_replace', 'repair_replace_return'))]}"/>
                            </div>
                        </div>
                    </div>

                </div>

                <h3 class="mt24">3. Set up other important fields.</h3>

                <group name="other-fields">
                    <label for="weeks_to_repair"/>
                    <div name="weeks_to_repair">
                        <field name="weeks_to_repair" class="oe_inline"/>
                        <span>weeks</span>
                    </div>

                    <field name="return_date"/>

                    <field name="replacement_product_id" options="{'no_create': True}"
                        attrs="{'invisible': [('operation_type', 'not in', ('repair_replace', 'repair_replace_return'))], 'required': [('operation_type', 'in', ('repair_replace', 'repair_replace_return'))]}"/>
                </group>

            </sheet>
            <footer>
                <button string="Create Transfers" name="action_run" type="object" class="btn-primary"/>
                <button string="Cancel" special="cancel" class="btn-secondary"/>
            </footer>
        </form>
    </field>
</record>

<record id="efarmer_helpdesk_repair_action_view_form" model="ir.actions.act_window">
    <field name="name">Repair/Replace</field>
    <field name="res_model">efarmer.helpdesk.repair</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="efarmer_helpdesk_repair_view_form"/>
    <field name="target">new</field>
</record>

</odoo>
