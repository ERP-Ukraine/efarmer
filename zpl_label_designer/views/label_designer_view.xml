<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="zld_label_form" model="ir.ui.view">
            <field name="name">zld.label.form</field>
            <field name="model">zld.label</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Label View" js_class="zld_label_form_view">
                    <header groups="zpl_label_designer.zld_security_group_manager">
                        <button name="open_in_designer" string="Open in Designer" type="object" invisible="designer_label_id == False" />
                        <button name="publish" string="Publish" type="object" class="oe_highlight" invisible="action_report_id != False" />
                        <button name="unpublish" string="Unpublish" type="object" invisible="action_report_id == False" />
                        <button name="open_view" string="Open Label View" type="object" groups="base.group_no_one" invisible="view_id == False" />
                    </header>

                    <sheet>
                        <div class="alert alert-info text-center pt-4 pb-4" role="alert" invisible="is_published == False or is_modified == False">
                            You made a change to the ZPL label design. In order to apply them
                            you need to click “Update Published Label“ button.
                        </div>

                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Label Name" class="oe_inline me-3" />
                                <field name="is_published" invisible="1" /> <!-- Required because it is used in the invisible condition above -->

                                <span class="badge bg-success rounded-pill o_field_badge bg-opacity-50" invisible="is_published == False">Published</span>
                                <span class="badge bg-secondary rounded-pill o_field_badge bg-opacity-50" invisible="is_published != False">Not Published</span>
                            </h1>
                        </div>

                        <group>
                            <group name="label_main">
                                <field name="model_id" />
                                <field name="dpi" />
                                <field name="width" />
                                <field name="height" />
                                <field name="orientation" />

                                <field name="view_id" invisible="1" /> <!-- Required because it is used in the invisible condition above -->
                                <field name="action_report_id" invisible="1" /> <!-- Required because it is used in the invisible condition above -->
                                <field name="is_modified" invisible="1" /> <!-- Required because it is used in the invisible condition above -->
                                <field name="designer_label_id" invisible="1" /> <!-- Required because it is used in the invisible condition above -->
                            </group>
                            <group invisible="action_report_id == False">
                                <field name="convert_to_pdf" />

                                <div class="accordion mt-2" colspan="2">
                                    <div class="accordion-item">
                                        <div class="accordion-header">
                                            <a role="button"
                                            class="accordion-button collapsed text-decoration-none"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#zld_pdf_experimental_info"
                                            aria-expanded="false"
                                            aria-controls="zld_pdf_experimental_info">
                                                <i class="fa fa-flask me-2" /> Experimental Feature - PDF Conversion
                                            </a>
                                        </div>
                                        <div id="zld_pdf_experimental_info" class="accordion-collapse collapse">
                                            <div class="accordion-body">
                                                <p>
                                                    This feature converts ZPL labels to PDF format using the <a href="https://labelary.com/" target="_blank">Labelary API</a>
                                                    before printing or downloading reports. This is an experimental feature that relies on an external service.
                                                </p>
                                                <p><strong>Important Limitations:</strong></p>
                                                <ul>
                                                    <li><strong>Rate Limits:</strong> Free plan allows 3 requests per second and 5,000 requests per day</li>
                                                    <li><strong>Request Limits:</strong> Maximum 50 labels per request, 1 MB request body size</li>
                                                    <li><strong>Label Dimensions:</strong> Maximum 15 inches per dimension</li>
                                                    <li><strong>Embedded Content:</strong> Images limited to 2,000 pixels, objects limited to 2 MB</li>
                                                </ul>
                                                <p>
                                                    Exceeding these limits may result in HTTP 429 (Too Many Requests) or HTTP 413 (Payload Too Large) errors.
                                                </p>
                                                <p>
                                                    If these limits are too restrictive, please contact us through our
                                                    <a href="https://ventortech.atlassian.net/servicedesk/customer/portal/1/group/-1" target="_blank">support portal</a>,
                                                    and we will investigate your request personally.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </group>
                        </group>

                        <div>
                            <small>To change label or its parameters click on "Open in Designer" button</small>
                        </div>

                        <notebook>
                            <page string="Preview" name="preview">
                                <group>
                                    <field name="preview" nolabel="1" readonly="1" widget="zld_label_preview" colspan="2" />
                                </group>
                                <div>
                                    <small>
                                        The preview may have inaccuracies in the display of elements due
                                        to the difference of the fonts used in the designer and in ZPL
                                    </small>
                                </div>
                                <div>
                                    <small>Preview provided by <a href="http://labelary.com/" target="_blank">Labelary</a></small>
                                </div>
                            </page>
                            <page string="Technical Details" name="technical" groups="base.group_no_one">
                                <group>
                                    <field name="print_report_name" />
                                    <field name="print_report_name_preview" />
                                    <field name="designer_label_id" />
                                    <field name="write_date" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="zpl_label_designer_label_list" model="ir.ui.view">
            <field name="name">zld.label.view</field>
            <field name="model">zld.label</field>
            <field name="arch" type="xml">
                <list js_class="zld_label_list_view" import="false">
                    <field name="name" />
                    <field name="model_id" />
                    <field name="is_published" />
                     <field name="convert_to_pdf" />
                </list>
            </field>
        </record>

        <record id="zld_label_action" model="ir.actions.act_window">
            <field name="name">Labels</field>
            <field name="res_model">zld.label</field>
            <field name="view_mode">list,form</field>

            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Creating labels is very easy and convenient. Try it using the create button!
                </p>
            </field>
        </record>

        <menuitem
            id="menu_zld_labels"
            name="Labels"
            parent="menu_zld"
            sequence="1"
            action="zld_label_action"
        />

    </data>
</odoo>
