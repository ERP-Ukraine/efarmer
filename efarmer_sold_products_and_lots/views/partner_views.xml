<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_stock_move_lines_for_partner" model="ir.actions.act_window">
            <field name="name">Sold Products &amp; Lots</field>
            <field name="res_model">stock.move.line</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_partner_id': active_id}</field>
            <field name="domain">['|', ('location_dest_id.usage', '=', 'customer'),('location_id.usage', '=', 'customer'),('partner_id', '=', active_id)]</field>
        </record>

    <record id="view_res_partner_inherit" model="ir.ui.view">
        <field name="name">res.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button type="action"
                            name="%(action_stock_move_lines_for_partner)d"
                            string="Sold Products &amp; Lots"
                            icon="fa-list"
                            class="oe_stat_button">
                </button>
            </xpath>
        </field>
    </record>
</odoo>
