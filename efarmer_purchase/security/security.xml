<?xml version="1.0"?>
<odoo>
    <data>

        <record id="purchase.group_purchase_user" model="res.groups">
            <field name="name">User: All documents</field>
            <field name="category_id" ref="base.module_category_inventory_purchase"/>
        </record>

        <record id="group_purchase_user_own_" model="res.groups">
            <field name="name">Purchase User: Own Documents</field>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="category_id" ref="base.module_category_inventory_purchase"/>
        </record>

        <record id="efarmer_purchase.group_purchase_user_own" model="ir.rule">
            <field name="name">Purchase User: Own Documents Only</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('efarmer_purchase.group_purchase_user_own_'))]"/>
        </record>

        <record id="purchase.group_purchase_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('efarmer_purchase.group_purchase_user_own_'))]"/>
            <field name="category_id" ref="base.module_category_inventory_purchase"/>
        </record>

        <record id="module_category_purchase_other" model="ir.module.category">
            <field name="name">Purchase</field>
            <field name="sequence">120</field>
        </record>

        <record id="efarmer_purchase_allow_confirm_rfq" model="res.groups">
            <field name="category_id" ref="module_category_purchase_other"/>
            <field name="name">Allow "Confirm RFQ" for Purchases</field>
        </record>

        <record id="efarmer_purchase_allow_confirm_demand" model="res.groups">
            <field name="category_id" ref="module_category_purchase_other"/>
            <field name="name">Allow "Confirm Demand" for Purchases</field>
        </record>

        <record id="efarmer_purchase_allow_confirm_demand_all" model="res.groups">
            <field name="category_id" ref="module_category_purchase_other"/>
            <field name="name">Allow “Confirm Demand“ for all departments</field>
        </record>

    </data>
</odoo>
