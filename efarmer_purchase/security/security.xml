<?xml version="1.0"?>
<odoo>
    <data>

        <record id="purchase.group_purchase_user" model="res.groups">
            <field name="name">User: Own documents</field>
        </record>

        <record id="efarmer_purchase.group_purchase_user" model="ir.rule">
            <field name="name">Purchase: Own Documents Only</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <record id="group_purchase_user_department" model="res.groups">
            <field name="name">User: Department Documents</field>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        </record>

        <record id="efarmer_purchase.rule_group_purchase_user_department" model="ir.rule">
            <field name="name">Purchase User: Department Documents</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">[('department_id', 'in', user.default_department_id.ids),('department_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('efarmer_purchase.group_purchase_user_department'))]"/>
        </record>

        <record id="group_purchase_user_all_document" model="res.groups">
            <field name="name">Purchase User: All Documents</field>
            <field name="implied_ids" eval="[(4, ref('efarmer_purchase.group_purchase_user_department'))]"/>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        </record>

        <record id="efarmer_purchase.rule_group_purchase_all_document" model="ir.rule">
            <field name="name">Purchase User: All Documents</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('efarmer_purchase.group_purchase_user_all_document'))]"/>
        </record>



        <record id="purchase.group_purchase_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('efarmer_purchase.group_purchase_user_all_document'))]"/>
        </record>

        <record id="efarmer_purchase_allow_confirm_rfq" model="res.groups">
            <field name="name">Allow "Confirm RFQ" for Purchases</field>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        </record>

        <record id="efarmer_purchase_allow_confirm_demand" model="res.groups">
            <field name="name">Allow "Confirm Demand" for Purchases</field>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        </record>

        <record id="efarmer_purchase_allow_confirm_demand_all" model="res.groups">
            <field name="name">Allow “Confirm Demand“ for all departments</field>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        </record>

        <record id="group_allow_purchase_order_lines" model="res.groups">
            <field name="name">Allow Purchase Order Lines</field>
            <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        </record>

    </data>
</odoo>
