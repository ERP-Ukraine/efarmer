<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="printnode_base.PrintNodeWorkstationListView"
       t-inherit="web.ListRenderer"
       t-inherit-mode="primary"
       owl="1">

        <xpath expr="//div[contains(@class, 'o_list_renderer') and contains(@class, 'table-responsive')]"
               position="before">

            <div class="o_onboarding_container collapse show w-100">
                <div class="o_notification_alert alert alert-info mb-0 py-2 w-100"
                     role="alert">

                    <div class="d-flex align-items-center justify-content-between gap-3">

                        <div class="d-flex align-items-start gap-2">
                            <i class="fa fa-info-circle mt-1 flex-shrink-0"
                               title="Information"></i>

                            <div>
                                <div>
                                    Configure workstations to quickly switch between printers
                                    when using Odoo on multiple computers.
                                </div>

                                <div class="mt-2">
                                    Create a workstation for each computer, assign the
                                    appropriate printers, and select the workstation that
                                    matches the computer currently in use.
                                </div>
                            </div>
                        </div>

                        <a href="https://ecosystem.ventor.tech/faq/direct-print/how-do-i-use-direct-print-workstations-to-print-to-different-printers"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-info btn-sm flex-shrink-0">
                            Learn More
                        </a>

                    </div>
                </div>
            </div>

        </xpath>

    </t>

</templates>
