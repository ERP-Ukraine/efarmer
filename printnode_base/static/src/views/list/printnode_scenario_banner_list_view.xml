<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="printnode_base.PrintNodeScenarioListView"
       t-inherit="web.ListRenderer"
       t-inherit-mode="primary"
       owl="1">

        <xpath expr="//div[contains(@class, 'o_list_renderer') and contains(@class, 'table-responsive')]"
               position="before">

            <div class="o_onboarding_container collapse show w-100">
                <div class="o_notification_alert alert alert-info mb-0 py-2 w-100"
                     role="alert">

                    <div class="d-flex align-items-center justify-content-between gap-3">

                        <div class="d-flex align-items-start gap-2">
                            <i class="fa fa-info-circle mt-1 flex-shrink-0"
                               title="Information"></i>

                            <div>
                                <div>
                                    This menu allows you to activate and configure automated
                                    print scenarios for the most common workflows in Odoo.
                                </div>

                                <div class="mt-2">
                                    The available scenarios cover standard Odoo modules only.
                                    Additional automation scenarios for Manufacturing (MRP)
                                    are available in the Direct Print for MRP add-on, which can
                                    be downloaded from the Odoo Apps Store or from our portal.
                                </div>
                            </div>
                        </div>

                        <a href="https://ecosystem.ventor.tech/faq/direct-print/how-to-use-automatic-printing-scenarios"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-info btn-sm flex-shrink-0">
                            Learn More
                        </a>

                    </div>
                </div>
            </div>

        </xpath>

    </t>

</templates>
