<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="printnode_base.PrintNodeMapActionServerListView"
       t-inherit="web.ListRenderer"
       t-inherit-mode="primary"
       owl="1">

        <xpath expr="//div[contains(@class, 'o_list_renderer') and contains(@class, 'table-responsive')]"
               position="before">

            <div class="o_onboarding_container collapse show w-100">
                <div class="o_notification_alert alert alert-info mb-0 py-2 w-100"
                     role="alert">

                    <div class="d-flex align-items-center justify-content-between gap-3">

                        <div class="d-flex align-items-start gap-2">
                            <i class="fa fa-info-circle mt-1 flex-shrink-0"
                               title="Information"></i>

                            <div>
                                This menu allows you to configure print wizards for labels and reports,
                                with options to select the number of copies and printer settings before printing.
                            </div>
                        </div>

                        <a href="https://ecosystem.ventor.tech/faq/direct-print/how-to-set-up-the-number-of-copies-before-printing-the-label-or-report"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-info btn-sm flex-shrink-0">
                            Learn More
                        </a>

                    </div>
                </div>
            </div>

        </xpath>

    </t>

</templates>
