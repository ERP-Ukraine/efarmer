<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="jpk_gtu_list" model="ir.ui.view">
        <field name="name">jpk_gtu_list</field>
        <field name="model">jpk.gtu</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="jpk_gtu_form" model="ir.ui.view">
        <field name="name">jpk_gtu_form</field>
        <field name="model">jpk.gtu</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1><field name="name"/></h1>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
