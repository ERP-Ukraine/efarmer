<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form_trilab" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="x_pl_vat_gtu" string="GTU"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list/field[@name='tax_ids']" position="before">
                <field name="x_pl_vat_gtu" string="GTU"
                       column_invisible="parent.move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>

            <group name="accounting_info_group" position="inside">
                <field name="x_journal_entry_number" invisible="country_code != 'PL'"/>
            </group>

            <xpath expr="//group[@name='misc_group']" position="inside">
                <field name="x_journal_entry_number" invisible="country_code != 'PL'"/>
            </xpath>

            <notebook position="inside">
                <page id="pl_vat" string="PL VAT" invisible="move_type == 'entry' or country_code != 'PL'">
                    <group>
                        <group>
                            <field name="pl_vat_date"
                                   invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                            <field name="x_pl_vat_mpp"
                                   invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"/>
                            <field name="x_pl_vat_dokument_zakupu"
                                   invisible="move_type not in ('in_invoice', 'in_refund')"/>
                            <field name="x_pl_vat_imp" invisible="move_type not in ('in_invoice', 'in_refund')"/>
                            <field name="x_pl_vat_reverse_charge"
                                   invisible="move_type not in ('out_invoice', 'out_refund')"
                                   readonly="state != 'draft'"/>
                            <field name="x_pl_vat_typ_dokumentu"
                                   invisible="move_type not in ('out_invoice', 'out_refund')"
                                   readonly="state != 'draft'"/>
                            <field name="x_pl_vat_sw" invisible="move_type not in ('out_invoice', 'out_refund')"
                                   readonly="state != 'draft'"/>
                            <field name="x_pl_vat_ee" invisible="move_type not in ('out_invoice', 'out_refund')"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="x_pl_vat_tp"
                                   invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"
                                   readonly="move_type in ('out_invoice', 'out_refund') and state != 'draft'"/>
                            <field name="x_pl_vat_tt_wnt" invisible="move_type not in ('in_invoice', 'in_refund')"/>
                            <field name="x_pl_vat_tt_d" invisible="move_type not in ('out_invoice', 'out_refund')"
                                   readonly="state != 'draft'"/>
                            <field name="x_pl_vat_mr_t" invisible="move_type not in ('out_invoice', 'out_refund')"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group invisible="move_type not in ('out_invoice', 'out_refund')">
                            <field name="x_pl_vat_mr_uz" readonly="state != 'draft'"/>
                            <field name="x_pl_vat_i42" readonly="state != 'draft'"/>
                            <field name="x_pl_vat_i63" readonly="state != 'draft'"/>
                            <field name="x_pl_vat_b_spv" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="x_pl_vat_b_spv_dostawa"
                                   invisible="move_type not in ('out_invoice', 'out_refund')"
                                   readonly="state != 'draft'"/>
                            <field name="x_pl_vat_b_mpv_prowizja"
                                   invisible="move_type not in ('out_invoice', 'out_refund')"
                                   readonly="state != 'draft'"/>
                            <field name="x_pl_vat_korekta_podstawy_opodt"
                                   invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund')"
                                   readonly="move_type in ('out_invoice', 'out_refund') and state != 'draft'"/>
                        </group>
                        <group>
                            <field name="x_pl_vat_wsto_ee" invisible="move_type not in ('out_invoice', 'out_refund')"
                                   readonly="state != 'draft'"/>
                            <field name="x_pl_vat_ied" invisible="move_type not in ('out_invoice', 'out_refund')"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="x_pl_change_jpk_proof"
                                   readonly="move_type in ('out_invoice', 'out_refund') and state != 'draft'"/>
                        </group>
                        <group>
                            <field name="x_pl_ksef_invoice_number"
                                   readonly="move_type in ('out_invoice', 'out_refund') and state != 'draft'"/>
                            <field name="x_pl_ksef_invoice_proof"
                                   readonly="move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund') and x_pl_ksef_invoice_number"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_account_invoice_filter" model="ir.ui.view">
        <field name="name">account.invoice.select</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="myinvoices" position="before">
                <field name="x_pl_ksef_invoice_number" string="KSeF Invoice Number"/>
            </filter>

            <filter name="late" position="after">
                <filter name="x_pl_ksef_invoice_number" string="KSeF Invoice"
                        domain="[('x_pl_ksef_invoice_number', '!=', False)]"/>
            </filter>

        </field>
    </record>
</odoo>
