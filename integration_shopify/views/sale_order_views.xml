<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_order_from_inherit_shopify" model="ir.ui.view">
            <field name="name">sale.order.form.view.inherit.shopify</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="integration.view_order_from_inherit"/>
            <field name="arch" type="xml">
                <field name="sub_status_id" position="after">
                    <field name="shopify_fulfilment_status" readonly="1"
                           invisible="type_api != 'shopify'"/>
                    <!-- shopify_risk_level is invisible here; its value drives the alerts below
                         and the invisible conditions in the Store Specific Fields section. -->
                    <field name="shopify_risk_level" invisible="1"/>
                    <label string="Shopify Risk" for="shopify_risk_recommendation"
                           invisible="type_api != 'shopify' or not shopify_risk_level"/>
                    <div invisible="type_api != 'shopify' or not shopify_risk_level">
                        <span class="text-danger fw-bold" invisible="shopify_risk_level != 'high'">
                            <i class="fa fa-times-circle me-1"/>Chargeback risk is high. Consider canceling this order.
                        </span>
                        <span class="text-warning fw-bold" invisible="shopify_risk_level != 'medium'">
                            <i class="fa fa-exclamation-triangle me-1"/>Chargeback risk is medium. Confirm with the customer before fulfilling.
                        </span>
                        <span class="text-success fw-bold" invisible="shopify_risk_level != 'low'">
                            <i class="fa fa-check-circle me-1"/>Chargeback risk is low. You can fulfill this order.
                        </span>
                    </div>
                </field>

                <xpath expr="//notebook/page[@name='sales_integration']//group[@name='integration_store_specific']/." position="inside">
                    <field name="integration_sale_channel_id" readonly="1" invisible="type_api != 'shopify'" />
                    <field name="integration_order_source_name_id" readonly="1" invisible="type_api != 'shopify'" />
                    <field name="external_tag_ids" readonly="1" widget="many2many_tags" invisible="type_api != 'shopify'" domain="[('ttype', '=', 'order')]"/>
                    <label string="Shopify Risk" for="shopify_risk_recommendation"
                           invisible="type_api != 'shopify'"/>
                    <div class="o_row" colspan="1" invisible="type_api != 'shopify'">
                        <field name="shopify_risk_recommendation" widget="badge" readonly="1" style="max-width: 150px;"
                               class="oe_inline w-auto" invisible="not shopify_risk_recommendation"/>
                        <button name="action_view_order_risks" type="object"
                                string="View Risk Details" class="btn-link mb-1 px-0"
                                invisible="not shopify_risk_level"/>
                    </div>
                </xpath>

                <field name="payment_method_id" position="replace">
                    <!-- Non-Shopify: single payment method -->
                    <field name="payment_method_id" string="E-Commerce Payment Methods" options="{'no_create': True}" invisible="type_api == 'shopify'"/>
                    <!-- Shopify: multiple payment methods + primary -->
                    <field name="payment_method_ids" readonly="1" options="{'no_create': True}" invisible="type_api != 'shopify'" widget="many2many_tags"/>
                    <field name="payment_method_id" string="Primary E-Commerce Payment Method" options="{'no_create': True}" invisible="type_api != 'shopify'"/>
                </field>
            </field>
        </record>

        <record id="sale_order_view_search" model="ir.ui.view">
            <field name="name">sale.order.view.search</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <search>
                    <field name="integration_sale_channel_id"/>
                    <group>
                        <filter string="Sale Channel" name="group_by_integration_sale_channel_id" context="{'group_by': 'integration_sale_channel_id'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>
