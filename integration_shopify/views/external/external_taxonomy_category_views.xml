<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="integration_taxonomy_category_external_view_tree" model="ir.ui.view">
            <field name="name">external.taxonomy.category.view.list</field>
            <field name="model">external.taxonomy.category</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0" open_form_view="0">
                    <field name="integration_id"/>
                    <field name="code"/>
                    <field name="complete_name"/>
                    <field name="level"/>
                    <field name="is_archived"/>
                </list>
            </field>
        </record>

        <record id="integration_taxonomy_category_external_view_form" model="ir.ui.view">
            <field name="name">external.taxonomy.category.view.form</field>
            <field name="model">external.taxonomy.category</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="complete_name"/>
                                <field name="code"/>
                                <field name="integration_id"/>
                            </group>
                            <group>
                                <field name="parent_id"/>
                                <field name="level"/>
                                <field name="is_archived"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="integration_taxonomy_category_external_view_search" model="ir.ui.view">
            <field name="name">external.taxonomy.category.view.search</field>
            <field name="model">external.taxonomy.category</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="complete_name"/>
                    <field name="code"/>
                    <field name="integration_id"/>
                    <separator/>
                    <filter name="active_only" string="Active Only"
                            domain="[('is_archived', '=', False)]"/>
                    <filter name="archived" string="Archived"
                            domain="[('is_archived', '=', True)]"/>
                    <group>
                        <filter name="group_by_integration" string="Integration"
                                context="{'group_by': 'integration_id'}"/>
                        <filter name="group_by_level" string="Level"
                                context="{'group_by': 'level'}"/>
                        <filter name="group_by_parent" string="Parent Category"
                                context="{'group_by': 'parent_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="integration_taxonomy_category_external_action" model="ir.actions.act_window">
            <field name="name">External Taxonomy Categories</field>
            <field name="path">eci-shopify-external-taxonomy-categories</field>
            <field name="res_model">external.taxonomy.category</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="integration_taxonomy_category_external_view_search"/>
            <field name="context">{'search_default_active_only': 1}</field>
        </record>

    </data>
</odoo>
