<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="external_sale_channel_view_tree" model="ir.ui.view">
            <field name="name">external.sale.channel.view.list</field>
            <field name="model">external.sale.channel</field>
            <field name="arch" type="xml">
                <list editable="bottom" create="0">
                    <field name="id" groups="base.group_no_one"/>
                    <field name="integration_id" readonly="1"/>
                    <field name="name" readonly="1"/>
                    <field name="external_id" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="external_sale_channel_view_search" model="ir.ui.view">
            <field name="name">external.sale.channel.view.search</field>
            <field name="model">external.sale.channel</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" readonly="1"/>
                    <field name="external_id" readonly="1"/>
                    <group>
                        <filter string="E-Commerce Store" name="group_by_integration_id" context="{'group_by': 'integration_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="external_sale_channel_action" model="ir.actions.act_window">
            <field name="name">External Sales Channel</field>
            <field name="path">eci-external-sale-channels</field>
            <field name="res_model">external.sale.channel</field>
            <field name="view_mode">list</field>
            <field name="group_ids" eval="[(4, ref('base.group_no_one'))]"/>
        </record>

    </data>
</odoo>
