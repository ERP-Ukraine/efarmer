#. module: integration_shopify
#: model:ir.model.fields,help:integration_shopify.field_external_order_risk__recommendation
msgid ""
"\n"
"            Accept: Low risk - proceed with order fulfillment as normal\n"
"            Investigate: Medium risk - review order details before "
"processing\n"
"            Cancel: High risk - cancel order due to suspected fraud\n"
"        "
msgstr ""
"\n"
"            Aceptar: Riesgo bajo: continuar con el despacho del pedido con "
"normalidad\n"
"            Investigar: Riesgo medio: revisar los detalles del pedido antes "
"de procesarlo\n"
"            Cancelar: Riesgo alto: cancelar el pedido por sospecha de "
"fraude\n"
"        "

