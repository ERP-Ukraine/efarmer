#. module: integration_shopify
#: model_terms:ir.ui.view,arch_db:integration_shopify.view_sale_integration_form
msgid ""
"<span class=\"border-start border-warning border-2 d-block ps-2 sale-"
"pricelist-warning\" invisible=\"not is_integration_shopify\">\n"
"                        <strong>Note:</strong> This pricelist is used for "
"export only - its price goes to Shopify as the Price,\n"
"                        and the regular Odoo price becomes the "
"<strong>Compare at Price</strong>.<br/>\n"
"                        On import, if <strong>Compare at Price</strong> is "
"set in Shopify, it will override the regular price in Odoo.\n"
"                        Shopify's <strong>Price</strong> or <strong>Compare "
"at Price</strong> are never imported into this pricelist.\n"
"                    </span>"
msgstr ""
"<span class=\"border-start border-warning border-2 d-block ps-2 sale-"
"pricelist-warning\" invisible=\"not is_integration_shopify\">\n"
"                        <strong>Nota:</strong> Esta lista de precios se usa "
"solo para exportación: su precio se envía a Shopify como Precio,\n"
"                        y el precio normal de Odoo pasa a ser el "
"<strong>Precio de Comparacion</strong>.<br/>\n"
"                        Al importar, si <strong>Precio de Comparacion</"
"strong> está configurado en Shopify, sobrescribirá el precio normal en "
"Odoo.\n"
"                        Shopify's <strong>Precio</strong> o <strong>Precio "
"de Comparación</strong> nunca se importan en esta lista de precios.\n"
"                    </span>"

