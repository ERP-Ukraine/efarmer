<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_vat_ue">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <center>
                            <h2>VAT UE</h2>
                        </center>
                        <table width="100%">
                            <tr>
                                <td width="20%">
                                    <b>Version:</b>
                                </td>
                                <td width="80%">
                                    <span t-field="doc.version"/>
                                </td>
                                <td/>
                                <td/>
                            </tr>
                            <tr>
                                <td width="20%">
                                    <b>Month:</b>
                                </td>
                                <td width="80%">
                                    <span t-field="doc.month"/>
                                </td>
                                <td/>
                                <td/>
                            </tr>
                            <tr>
                                <td width="20%">
                                    <b>Year:</b>
                                </td>
                                <td width="80%">
                                    <span t-out="doc.year"/>
                                </td>
                            </tr>
                            <hr/>
                            <div t-if="cel_zlozenia == 1">
                                <tr>
                                    <td width="40%">
                                        <p style="margin:0;">
                                            <b>Cel Złożenia:</b>
                                        </p>
                                    </td>
                                </tr>
                            </div>
                        </table>
                        <div style="padding-top:20px;"/>
                        <center width="100%">
                            <h3>C. Informacja o Wewnątrzwspólnotowych Dostawach Towarów</h3>
                        </center>
                        <table width="100%">
                            <t t-foreach="doc.group_1_line_ids" t-as="group_line">
                                <tr>
                                    <td>
                                        <span class="pl-4">
                                            <span t-field="group_line.country_code"/>
                                            <span t-field="group_line.nip"/>
                                            <span t-field="group_line.amount"/>
                                            <span t-field="group_line.tt"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </table>
                        <center width="100%">
                            <h3>D. Informacja o Wewnątrzwspólnotowych Nabyciach Towarów</h3>
                        </center>
                        <table width="100%">
                            <t t-foreach="doc.group_2_line_ids" t-as="group_line">
                                <tr>
                                    <td>
                                        <span class="pl-4">
                                            <span t-field="group_line.country_code"/>
                                            <span t-field="group_line.nip"/>
                                            <span t-field="group_line.amount"/>
                                            <span t-field="group_line.tt"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </table>
                        <center width="100%">
                            <h3>E. Informacja o Wewnątrzwspólnotowym Świadczeniu Usług</h3>
                        </center>
                        <table width="100%">
                            <t t-foreach="doc.group_3_line_ids" t-as="group_line">
                                <tr>
                                    <td>
                                        <span class="pl-4">
                                            <span t-field="group_line.country_code"/>
                                            <span t-field="group_line.nip"/>
                                            <span t-field="group_line.amount"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </table>
                        <br/>
                        <br/>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_vat_ue_pdf" model="ir.actions.report">
        <field name="name">VAT UE</field>
        <field name="model">jpk.vat.ue</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">trilab_jpk_vat.report_vat_ue</field>
        <field name="report_file">trilab_jpk_vat.report_vat_ue</field>
        <field name="binding_model_id" ref="trilab_jpk_vat.model_jpk_vat_ue"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
