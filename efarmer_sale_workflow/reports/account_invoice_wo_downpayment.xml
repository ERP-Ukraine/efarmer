<?xml version='1.0' encoding='utf-8'?>
<odoo>

<template id="report_account_invoice_wo_downpayment_document" inherit_id="account.report_invoice_document" primary="True">
    <!-- modify lines: skip downpayment with negative subtotal -->
    <xpath expr="//tbody[hasclass('invoice_tbody')]/t[1]" position="before">
        <t t-set="current_subtotal" t-value="0"/>
        <t t-set="deposit_subtotal" t-value="0"/>
        <t t-set="deposit_total" t-value="0"/>
    </xpath>
    <xpath expr="//tbody[hasclass('invoice_tbody')]/t[@t-foreach='lines']/t[@t-set='current_subtotal' and @groups='account.group_show_line_subtotals_tax_excluded']" position="replace">
    </xpath>
    <xpath expr="//tbody[hasclass('invoice_tbody')]/t[@t-foreach='lines']/t[@t-set='current_subtotal' and @groups='account.group_show_line_subtotals_tax_included']" position="replace">
    </xpath>
    <xpath expr="//tbody[hasclass('invoice_tbody')]/t[@t-foreach='lines']/tr[1]" position="before">
        <t t-if="line.has_deposit_deducted()">
            <t t-set="deposit_subtotal" t-value="deposit_subtotal + line.price_subtotal"/>
            <t t-set="deposit_total" t-value="deposit_total + line.price_total"/>
        </t>
    </xpath>
    <xpath expr="//tbody[hasclass('invoice_tbody')]/t[@t-foreach='lines']/tr[1]" position="attributes">
        <attribute name="t-if">not line.has_deposit_deducted()</attribute>
    </xpath>
    <xpath expr="//tbody[hasclass('invoice_tbody')]/t[@t-foreach='lines']/tr[1]/t[1]" position="before">
        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
           groups="account.group_show_line_subtotals_tax_excluded" />
        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
           groups="account.group_show_line_subtotals_tax_included" />
    </xpath>
    <!-- modify total: deduct downpayment amount -->
    <xpath expr="//div[@id='total']//t[@t-foreach='o.amount_by_group']" position="attributes">
        <attribute name="t-foreach">o.with_context(without_deposit=True).amount_by_group</attribute>
    </xpath>
    <xpath expr="//div[@id='total']//span[@t-field='o.amount_untaxed']" position="replace">
        <t t-set="invoice_subtotal" t-value="o.amount_untaxed - deposit_subtotal"/>
        <span t-esc="invoice_subtotal"
              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
    </xpath>
    <xpath expr="//div[@id='total']//span[@t-field='o.amount_total']" position="replace">
        <t t-set="invoice_total" t-value="o.amount_total - deposit_total"/>
        <span t-esc="invoice_total"
              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
    </xpath>
</template>

<template id="report_account_invoice_wo_downpayment">
    <t t-call="web.html_container">
        <t t-set="efarmer_address_placement" t-value="True"/>
        <t t-foreach="docs" t-as="doc">
            <t t-set="o" t-value="doc"/>
            <t t-set="lang" t-value="o.invoice_user_id.sudo().lang if o.type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
            <t t-call="efarmer_sale_workflow.report_account_invoice_wo_downpayment_document" t-lang="lang"/>
        </t>
    </t>
</template>

<report
    id="action_report_account_invoice_wo_downpayment"
    string="Invoices without Downpayment"
    model="account.move"
    report_type="qweb-pdf"
    file="efarmer_sale_workflow.report_account_invoice_wo_downpayment"
    name="efarmer_sale_workflow.report_account_invoice_wo_downpayment"
    print_report_name="'Invoice - %s' % (object.name)"
    />

</odoo>
