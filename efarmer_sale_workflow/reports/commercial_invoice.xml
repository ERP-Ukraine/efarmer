<?xml version='1.0' encoding='utf-8'?>
<odoo>

<template id="report_commercial_invoice_document" inherit_id="sale.report_saleorder_document" primary="True">
    <!-- Set a custom header format. -->
    <xpath expr="//div[hasclass('page')]/h2" position="replace">
        <h2 class="mt16">
            <span>Сommercial Invoice # </span>
            <span t-field="doc.name"/>
        </h2>
    </xpath>
    <!-- Hide the payment term note. -->
    <xpath expr="//span[@name='payment-term-name']/.." position="replace"/>
    <!-- Display `HS Code` and `Country of origin` into the description column. -->
    <xpath expr="//table[hasclass('o_main_table')]//td[@name='td_name']" position="inside">
        <div name="hs_code" t-if="line.product_id.intrastat_id.code">
            HS Code: <span t-field="line.product_id.intrastat_id.code"/>
        </div>
        <div name="country_of_origin" t-if="line.product_id.intrastat_origin_country_id.name">
            Country of Origin: <span t-field="line.product_id.intrastat_origin_country_id.name"/>
        </div>
    </xpath>
</template>

<template id="report_commercial_invoice">
    <t t-call="web.html_container">
        <t t-set="is_pro_forma" t-value="False"/>
        <t t-foreach="docs" t-as="doc">
            <t t-call="efarmer_sale_workflow.report_commercial_invoice_document"
                t-lang="doc.partner_id.lang"/>
        </t>
    </t>
</template>

<record id="action_report_commercial_invoice" model="ir.actions.report">
    <field name="name">Сommercial Invoice</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">efarmer_sale_workflow.report_commercial_invoice</field>
    <field name="report_file">efarmer_sale_workflow.report_commercial_invoice</field>
    <field name="print_report_name">'Сommercial Invoice - %s' % (object.name)</field>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
</record>


    <template id="report_picking_commercial_invoice_document_document">
        <t t-call="web.external_layout">

            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <div class="row">
                <div class="col-6">
                    <ul class="list-unstyled">
                        <strong>From: </strong>
                        <li><t t-esc="doc.company_id.name"/></li>
                        <li><t t-esc="doc.company_id.street"/></li>
                        <li><t t-esc="doc.company_id.city"/></li>
                        <li><t t-esc="doc.company_id.email"/></li>
                        <li><t t-esc="doc.company_id.phone"/></li>
                    </ul>
                </div>
                <div class="col-6">

                        <strong>Consignee: </strong>
                        <div t-field="doc.sale_id.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                        <p t-if="doc.sale_id.partner_id.vat"><t
                                t-esc="doc.sale_id.company_id.account_fiscal_country_id.vat_label or 'Tax ID'"/>: <span
                                t-field="doc.partner_id.vat"/></p>

                    <t t-if="doc.sale_id.partner_shipping_id == doc.sale_id.partner_invoice_id
                             and doc.sale_id.partner_invoice_id != doc.sale_id.partner_id
                             or doc.sale_id.partner_shipping_id != doc.sale_id.partner_invoice_id">
                        <t t-set="information_block">
                            <strong t-if="doc.sale_id.partner_shipping_id == doc.sale_id.partner_invoice_id">Invoicing
                                and Shipping Address:</strong>
                            <strong t-if="doc.sale_id.partner_shipping_id != doc.sale_id.partner_invoice_id">Invoicing
                                Address:</strong>
                            <div t-field="doc.sale_id.partner_invoice_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                            <t t-if="doc.sale_id.partner_shipping_id != doc.sale_id.partner_invoice_id">
                                <strong>Shipping Address:</strong>
                                <div t-field="doc.sale_id.partner_shipping_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                            </t>
                        </t>
                    </t>
                </div>
            </div>
            <div class="page">
                <div class="oe_structure"/>
                <h2 class="mt16">
                    <span t-if="doc.sale_id">Commercial Invoice # </span>
                    <span t-field="doc.sale_id.name"/>
                </h2>
                <div class="row mt32 mb32" id="informations">
                    <div t-if="doc.date_done" class="col-auto col-3 mw-100 mb-2">
                        <strong>Delivery Date:</strong>
                        <p class="m-0" t-field="doc.date_done"/>
                    </div>
                    <div t-if="doc.sale_id.user_id.name" class="col-auto col-3 mw-100 mb-2">
                        <strong>Salesperson:</strong>
                        <p class="m-0" t-field="doc.sale_id.user_id"/>
                    </div>
                </div>
                <!-- Is there a discount on at least one line? -->
                <t t-set="display_discount" t-value="any(l.discount for l in doc.sale_id.order_line)"/>
                <table class="table table-sm o_main_table">
                    <!-- In case we want to repeat the header, remove "display: table-row-group" -->
                    <thead style="display: table-row-group">
                        <tr>
                            <th name="th_description" class="text-left">Description</th>
                            <th name="th_quantity" class="text-right">Quantity</th>
                            <th name="th_priceunit" class="text-right">Unit Price</th>
                            <th name="th_discount" class="text-right">
                                <span>Disc.%</span>
                            </th>
                            <th name="th_subtotal" class="text-right">
                                <span groups="account.group_show_line_subtotals_tax_excluded">Amount</span>
                                <span groups="account.group_show_line_subtotals_tax_included">Total Price</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">

                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="weight_sum" t-value="0"/>
                        <t t-set="lines" t-value="list(set(doc.move_lines.sale_line_id))"/>
                        <t t-foreach="lines" t-as="line">
                            <t t-set="weight_sum" t-value="weight_sum + line.product_id.weight * line.product_uom_qty"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"
                               groups="account.group_show_line_subtotals_tax_excluded"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total"
                               groups="account.group_show_line_subtotals_tax_included"/>

                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type">
                                    <td name="td_name"><span t-field="line.name"/></td>
                                    <td name="td_quantity" class="text-right">
                                        <span t-field="line.product_uom_qty"/>
                                        <span t-field="line.product_uom"/>
                                    </td>
                                    <td name="td_priceunit" class="text-right">
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td t-if="display_discount" class="text-right"
                                        groups="product.group_discount_per_so_line">
                                        <span t-field="line.discount"/>
                                    </td>
                                    <td name="td_subtotal" class="text-right o_price_total">
                                        <span t-field="line.price_subtotal"
                                              groups="account.group_show_line_subtotals_tax_excluded"/>
                                        <span t-field="line.price_total"
                                              groups="account.group_show_line_subtotals_tax_included"/>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="clearfix" name="so_total_summary">
                    <div id="total" class="row" name="total">
                        <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">
                            <table class="table table-sm">
                                <t t-set="tax_totals" t-value="json.loads(doc.sale_id.tax_totals_json)"/>
                                <tr class="border-black o_total">
                                    <td><strong>Total</strong></td>
                                    <td class="text-right">
                                        <span t-esc="tax_totals['formatted_amount_total']"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>


                <div class="oe_structure"/>
                <p t-if="not is_html_empty(doc.sale_id.payment_term_id.name)">
                    <strong>Weight: </strong>
                    <span t-esc="weight_sum"/>
                    <strong> kg.</strong>
                </p>
                <br>
                </br>
                <p>
                    <strong>This Invoice is for Customs Purposes</strong>
                </p>
            </div>
        </t>
    </template>



    <template id="picking_report_commercial_invoice">
        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">
                <t t-call="efarmer_sale_workflow.report_picking_commercial_invoice_document_document"
                   t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="action_picking_report_commercial_invoice" model="ir.actions.report">
        <field name="name">Сommercial Invoice</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">efarmer_sale_workflow.picking_report_commercial_invoice</field>
        <field name="report_file">efarmer_sale_workflow.picking_report_commercial_invoice</field>
        <field name="print_report_name">'Сommercial Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
