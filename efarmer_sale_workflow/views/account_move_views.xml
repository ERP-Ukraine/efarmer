<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="efarmer_sale_workflow_view_move_form_inherit" model="ir.ui.view">
            <field name="name">efarmer.sale.workflow.view.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <div name="journal_div" position="after">
                    <field name="is_manually_current_rate"/>
                    <field name="product_vat_id" readonly="is_manually_current_rate == False"/>
                    <field name="current_rate_pln" readonly="is_manually_current_rate == False"/>
                </div>
            </field>
    </record>
</odoo>
