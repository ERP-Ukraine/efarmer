<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.efarmer.sale.workflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_reports.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_reports_settings']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" title="This allows you to show additional notes about Vat Directives of EC">
                    <div class="o_setting_left_pane">
                        <field name="additional_vat_note"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="additional_vat_note"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." groups="base.group_multi_company"/>
                        <div class="text-muted">
                            Will show additional notes about Vat Directives of EC depends on contained products
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
