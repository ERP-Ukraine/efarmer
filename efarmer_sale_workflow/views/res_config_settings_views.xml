<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.efarmer.sale.workflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account_reports.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_reports_settings']" position="inside">
                <setting id="additional_vat_note" company_dependent="1"
                    help="Will show additional notes about Vat Directives of EC depends on contained products">
                    <field name="additional_vat_note"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
