<odoo>
    <data>
        <record id="view_delivery_terms_form" model="ir.ui.view">
            <field name="name">delivery.terms.form</field>
            <field name="model">delivery.terms</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="default_for_company"/>
                            <field name="company_id"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_delivery_terms_tree" model="ir.ui.view">
            <field name="name">delivery.terms.tree</field>
            <field name="model">delivery.terms</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="default_for_company"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>
        <record id="action_delivery_terms" model="ir.actions.act_window">
            <field name="name">Delivery Terms</field>
            <field name="res_model">delivery.terms</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="menu_delivery_terms" name="Delivery Terms" parent="sale.menu_sale_config" sequence="60"/>
        <menuitem id="menu_delivery_terms_form" name="Delivery Terms" parent="menu_delivery_terms" action="action_delivery_terms" sequence="10"/>
    </data>
</odoo>
