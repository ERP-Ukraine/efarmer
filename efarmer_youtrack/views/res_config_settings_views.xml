<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

            <record id="res_config_settings_view_form" model="ir.ui.view">
                <field name="name">res.config.settings.view.form</field>
                <field name="model">res.config.settings</field>
                <field name="inherit_id" ref="project.res_config_settings_view_form"/>
                <field name="arch" type="xml">
                    <xpath expr="//div[@name='analytic']" position="after">
                        <h2>YouTrack Integration</h2>
                        <div class="row mt16 o_settings_container" id="youtrack_integration">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <div class="o_setting_left_pane">
                                    <field name="youtrack_is_active"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <label for="youtrack_is_active"/>
                                    <div class="text-muted">
                                        Synchronize Timesheets/Projects/Taks with YouTrack
                                    </div>
                                    <div class="content-group">
                                        <div class="mt16 row">
                                            <label for="youtrack_api_key" string="Token" class="col-lg-3 o_light_label" />
                                            <field name="youtrack_api_key" class="oe_inline" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </xpath>
                </field>
            </record>

    </data>
</odoo>
