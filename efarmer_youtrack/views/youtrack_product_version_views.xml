<odoo>
    <data>

        <record id="youtrack_product_version_tree" model="ir.ui.view">
            <field name="name">youtrack_product_version.tree</field>
            <field name="model">youtrack.product.version</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="YouTrack Product Versions">
                    <field name="name" />
                    <field name="youtrack_id" />
                </list>
            </field>
        </record>

        <record id="youtrack_product_version_form" model="ir.ui.view">
            <field name="name">youtrack_product_version.form</field>
            <field name="model">youtrack.product.version</field>
            <field name="arch" type="xml">
                <form string="YouTrack Product Version Form">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                            </group>
                            <group>
                                <field name="youtrack_id" />
                            </group>
                        </group>                            
                    </sheet>
                </form>
            </field>
        </record>

        <record id='youtrack_product_version_list_action' model='ir.actions.act_window'>
            <field name="name">YouTrack Product Versions</field>
            <field name="res_model">youtrack.product.version</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="youtrack_product_version_tree"/>
        </record>

        <menuitem
            id="menu_project_config_product_versions"
            action="youtrack_product_version_list_action" 
            name="Product Versions"
            parent="project.menu_project_config"
            sequence="31"
        />

    </data>
</odoo>
