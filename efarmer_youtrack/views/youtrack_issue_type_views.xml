<odoo>
    <data>

        <record id="youtrack_issue_type_tree" model="ir.ui.view">
            <field name="name">youtrack_issue_type.tree</field>
            <field name="model">youtrack.issue.type</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="YouTrack Issue Types">
                    <field name="name" />
                    <field name="youtrack_id" />
                </tree>
            </field>
        </record>

        <record id="youtrack_issue_type_form" model="ir.ui.view">
            <field name="name">youtrack_issue_type.form</field>
            <field name="model">youtrack.issue.type</field>
            <field name="arch" type="xml">
                <form string="YouTrack Issue Type Form">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                            </group>
                            <group>
                                <field name="youtrack_id" />
                            </group>
                        </group>                            
                    </sheet>
                </form>
            </field>
        </record>

        <record id='youtrack_issue_type_list_action' model='ir.actions.act_window'>
            <field name="name">YouTrack Issue Types</field>
            <field name="res_model">youtrack.issue.type</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="youtrack_issue_type_tree"/>
        </record>

        <menuitem
            id="menu_project_config_issue_types"
            action="youtrack_issue_type_list_action" 
            name="Issue Types"
            parent="project.menu_project_config"
            sequence="30"
        />

    </data>
</odoo>
