<odoo>
    <data>

        <record id="youtrack_integration_tree" model="ir.ui.view">
            <field name="name">youtrack_integration.tree</field>
            <field name="model">youtrack.integration</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="YouTrack Integrations">
                    <field name="name" />
                    <field name="is_active" />
                    <field name="endpoint" />
                </list>
            </field>
        </record>

        <record id="youtrack_integration_form" model="ir.ui.view">
            <field name="name">youtrack_integration.form</field>
            <field name="model">youtrack.integration</field>
            <field name="arch" type="xml">
                <form string="YouTrack Integration Form">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="is_active" />
                                <field name="company_id" />
                            </group>
                            <group>
                                <field name="api_key_attr" />
                                <field name="api_key" />
                                <field name="endpoint" />
                            </group>
                        </group>

                        <notebook>
                            <page string="Operations">
                                <group>
                                    <group>
                                        <field name="api_method" />
                                        <field name="project_code" invisible="api_method not in ('youtrackIntegrationApiGetProject', 'youtrackIntegrationApiGetTasks')"/>
                                        <field name="date_from" invisible="api_method != 'youtrackIntegrationApiGetWorkItems'" />
                                        <button name="run_operation" type="object" string="Execute" class="oe_highlight" />
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id='youtrack_integration_list_action' model='ir.actions.act_window'>
            <field name="name">YouTrack Integrations</field>
            <field name="res_model">youtrack.integration</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="youtrack_integration_tree"/>
        </record>

        <menuitem
            id="menu_project_youtrack_operations"
            name="YouTrack"
            parent="project.menu_main_pm"
            groups="youtrack_integration_manager_group"
            sequence="99"
        />

        <menuitem
            id="youtrack_integrations"
            name="Integration"
            parent="menu_project_youtrack_operations"
            sequence="5"
            action="youtrack_integration_list_action"
        />

    </data>
</odoo>
