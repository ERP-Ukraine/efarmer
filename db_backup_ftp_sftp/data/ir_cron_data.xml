<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Hourly: already uploaded files are skipped, so frequent runs are
             cheap; they pick up the new daily backup soon after Odoo.sh
             writes it and resume after a run stopped by the time limit. -->
        <record id="ir_cron_db_remote_backup" model="ir.cron">
            <field name="name">Backup Copy: send ~/backup.daily to SFTP / FTP</field>
            <field name="model_id" ref="model_db_remote_backup"/>
            <field name="state">code</field>
            <field name="code">model._cron_run()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
