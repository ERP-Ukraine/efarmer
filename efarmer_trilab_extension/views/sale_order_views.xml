<odoo>
    <data>

        <record id="efarmer_trilab_view_order_form_inherit" model="ir.ui.view">
            <field name="name">efarmer_trilab.sale.order.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="trilab_invoice.view_order_form"/>
            <field name="arch" type="xml">

                <!-- Make Create Invoice button visible in "to_payment" and "to_confirm" states-->
                <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][2]" position="attributes">
                    <attribute name="attrs">{'invisible': ['|', ('x_is_poland', '=', True), '|', ('state', 'not in', ['to_payment', 'to_confirm', 'sale']), ('invoice_status', '!=', 'no')]}</attribute>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
