<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_fieldbee" model="ir.module.category">
        <field name="name">FieldBee</field>
    </record>

    <record id="group_serial_metadata_editor" model="res.groups">
        <field name="name">Serial Metadata Editor</field>
        <field name="category_id" ref="module_category_fieldbee"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Administrators are editors too -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_serial_metadata_editor'))]"/>
    </record>
</odoo>
