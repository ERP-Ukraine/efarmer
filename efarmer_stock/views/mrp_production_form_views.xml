<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="mrp_production_form_view_efarmer_stock_inherit" model="ir.ui.view">
            <field name="name">mrp.production.for.inherit.efarmer.stock</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='lot_producing_ids']" position="attributes">
                    <attribute name="domain">[('product_id', '=', product_id), ('company_id', '=', company_id), ('is_assigned', '=', False)]</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
