<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_operation_tree_return_lots" model="ir.ui.view">
        <field name="name">stock.move.line.return.lots</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="before">
                <field name="return_lot_ids" column_invisible="1"/>
            </field>
            <field name="lot_id" position="attributes">
                <attribute name="domain">[('id', 'in', return_lot_ids)] if return_lot_ids else [('product_id', '=', product_id)]</attribute>
            </field>
        </field>
    </record>
</odoo>
