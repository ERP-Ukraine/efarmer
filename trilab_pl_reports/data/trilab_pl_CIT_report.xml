<?xml version="1.0" encoding="UTF-8" ?>

<odoo>

    <record id="trilab_pl_CIT" model="account.report">
        <field name="name">PL CIT</field>
        <field name="root_report_id" ref="account_reports.profit_and_loss"/>
        <field name="country_id" ref="base.pl"/>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_analytic_groupby" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="filter_multi_company">selector</field>
        <field name="default_opening_date_filter">this_year</field>
        <field name="column_ids">
            <record id="trilab_pl_CIT_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>

        <field name="line_ids">
            <record id="trilab_pl_CIT_income" model="account.report.line">
                <field name="name">Income</field>
                <field name="code">INC_ALL</field>
                <field name="hierarchy_level" eval="0"/>
                <field name="aggregation_formula">INC_TAX.balance + INC_NTAX.balance</field>
            </record>

            <record id="trilab_pl_CIT_income_tax" model="account.report.line">
                <field name="name">Taxable Income</field>
                <field name="code">INC_TAX</field>
                <field name="parent_id" ref="trilab_pl_CIT_income"/>
                <field name="hierarchy_level" eval="1"/>
                <field name="domain_formula">-sum([('account_id.account_type', 'in', ('income', 'income_other')), ('analytic_distribution', '!=', 'NKUP')])
                </field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
            </record>

            <record id="trilab_pl_CIT_income_ntax" model="account.report.line">
                <field name="name">Non Taxable Income</field>
                <field name="code">INC_NTAX</field>
                <field name="parent_id" ref="trilab_pl_CIT_income"/>
                <field name="hierarchy_level" eval="1"/>
                <field name="domain_formula">-sum([('account_id.account_type', 'in', ('income', 'income_other')), ('analytic_distribution', '=', 'NKUP')])
                </field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
            </record>

            <record id="trilab_pl_CIT_expenses" model="account.report.line">
                <field name="name">Costs</field>
                <field name="code">EX_ALL</field>
                <field name="hierarchy_level" eval="0"/>
                <field name="aggregation_formula">EX_TAX.balance + EX_NTAX.balance</field>
            </record>

            <record id="trilab_pl_CIT_expenses_tax" model="account.report.line">
                <field name="name">Tax Deductible Costs</field>
                <field name="code">EX_TAX</field>
                <field name="parent_id" ref="trilab_pl_CIT_expenses"/>
                <field name="hierarchy_level" eval="1"/>
                <field name="domain_formula">sum([('account_id.account_type', 'in', ('expense', 'expense_direct_cost', 'expense_depreciation')), ('analytic_distribution', '!=', 'NKUP')])
                </field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
            </record>

            <record id="trilab_pl_CIT_expenses_ntax" model="account.report.line">
                <field name="name">Tax Non Deductible Costs</field>
                <field name="code">EX_NTAX</field>
                <field name="parent_id" ref="trilab_pl_CIT_expenses"/>
                <field name="hierarchy_level" eval="1"/>
                <field name="domain_formula">sum([('account_id.account_type', 'in', ('expense', 'expense_direct_cost', 'expense_depreciation')), ('analytic_distribution', '=', 'NKUP')])
                </field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
            </record>

            <record id="trilab_pl_CIT_revenue_tax" model="account.report.line">
                <field name="name">CIT Tax Base</field>
                <field name="code">REV_TAX</field>
                <field name="aggregation_formula">INC_TAX.balance - EX_TAX.balance</field>
                <field name="hierarchy_level" eval="0"/>
            </record>

            <record id="trilab_pl_CIT_revenue" model="account.report.line">
                <field name="name">Net Profit</field>
                <field name="code">REV_ALL</field>
                <field name="aggregation_formula">INC_ALL.balance - EX_ALL.balance</field>
                <field name="hierarchy_level" eval="0"/>
            </record>
        </field>
    </record>

</odoo>
