<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_journal_form_inherit" model="ir.ui.view">
        <field name="name">account.journal.form.inherit</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='bank_account']/group/group" position="inside">
                <field name="x_cash_valuation_visible" invisible="True"/>
                <field name="x_cash_valuation_as_draft" invisible="not x_cash_valuation_visible"/>
                <field name="x_cash_valuation_method" invisible="not x_cash_valuation_visible"/>
            </xpath>
        </field>
    </record>
</odoo>
