<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="utm_content_tree_view" model="ir.ui.view">
        <field name="name">utm.content tree view</field>
        <field name="model">utm.content</field>
        <field name="arch" type="xml">
            <tree string="Contents" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="utm_content_form_view" model="ir.ui.view">
        <field name="name">utm.content form view</field>
        <field name="model">utm.content</field>
        <field name="arch" type="xml">
            <form string="Content">
                <sheet>
                    <group name="base">
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="utm_content_action" model="ir.actions.act_window">
        <field name="name">Contents</field>
        <field name="res_model">utm.content</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_utm_content"
        action="utm_content_action"
        parent="utm.marketing_utm"
        sequence="5"
        groups="base.group_no_one"/>

</odoo>
