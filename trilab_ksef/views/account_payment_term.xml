<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_payment_term_form_ksef" model="ir.ui.view">
        <field name="name">account.payment.term.form.ksef</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="inside">
                <group>
                    <field name="x_ksef_payment_term_type"/>
                    <field name="x_ksef_payment_state_mapping"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
