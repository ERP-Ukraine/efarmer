<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ti_inherit" model="ir.ui.view">
        <field name="name">account.move.form.ti.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="trilab_invoice.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='x_invoice_sale_date']" position="after">
                <field name="x_ksef_invoice_date_applicability"
                       string="Invoice date or billing period"
                       attrs="{'required': [('x_is_poland', '=', True), ('move_type', '!=', 'entry')], 'invisible': ['|', ('move_type','=', 'entry'), ('x_is_poland', '=', False)]}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="trilab_jpk_base.view_move_form_trilab"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_invoice_sent']" position="after">
                <field name="x_ksef_show_check_invoice_status_btn" invisible="1"/>
                <button name="x_ksef_check_invoice_status"
                        string="Check KSeF Invoice Status"
                        type="object"
                        attrs="{'invisible': [('x_ksef_show_check_invoice_status_btn', '=', False)]}"/>
            </xpath>
            <xpath expr="//page[@id='pl_extra']" position="inside">
                <group string="Flags">
                    <field name="x_ksef_p_16" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="x_ksef_p_17" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="x_ksef_p_18" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="x_ksef_p_18a" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="x_ksef_p_23" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                </group>
                <group string="Exemptions">
                    <field name="x_ksef_p_19"
                           attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="x_ksef_p_19a"
                           attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('x_ksef_p_19', '=', False)]}"/>
                    <field name="x_ksef_p_19b"
                           attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('x_ksef_p_19', '=', False)]}"/>
                    <field name="x_ksef_p_19c"
                           attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('x_ksef_p_19', '=', False)]}"/>
                </group>
                <group string="Margin Procedure">
                    <field name="x_ksef_p_pmarzy"
                           attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                    <field name="x_ksef_p_pmarzy_2"
                           attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('x_ksef_p_pmarzy', '=', False)]}"/>
                    <field name="x_ksef_p_pmarzy_3_1"
                           attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('x_ksef_p_pmarzy', '=', False)]}"/>
                    <field name="x_ksef_p_pmarzy_3_2"
                           attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('x_ksef_p_pmarzy', '=', False)]}"/>
                    <field name="x_ksef_p_pmarzy_3_3"
                           attrs="{'readonly': [('state', '!=', 'draft')], 'invisible': [('x_ksef_p_pmarzy', '=', False)]}"/>
                </group>
                <group string="KSeF References">
                    <field name="x_pl_ksef_invoice_number" readonly="1" force_save="1"/>
                    <field name="x_ksef_invoice_reference" readonly="1"/>
                    <field name="x_ksef_session_reference" readonly="1"/>
                    <field name="x_ksef_session_type" readonly="1"/>
                    <field name="x_ksef_invoice_status" readonly="1"/>
                    <field name="x_ksef_last_invoice_status" readonly="1" groups="base.group_no_one"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
