<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ksef_settings_form" model="ir.ui.view">
        <field name="name">ksef.settings.form</field>
        <field name="model">ksef.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <label for="name"/>
                    <h1>
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="endpoint_url" required="True"/>
                            <field name="qr_code_url" required="True"/>

                            <field name="public_asymmetric_key_id" invisible="True"/>
                            <field name="public_asymmetric_key_id_datas"
                                   string="Public Asymmetric Key"
                                   widget="binary"
                                   filename="public_asymmetric_key_id_name"
                                   required="True"/>
                            <field name="public_asymmetric_key_id_name" invisible="True"/>
                            <field name="public_symmetric_key_id" invisible="True"/>
                            <field name="public_symmetric_key_id_datas"
                                   string="Public Symmetric Key"
                                   widget="binary"
                                   filename="public_symmetric_key_id_name"
                                   required="True"/>
                            <field name="public_symmetric_key_id_name" invisible="True"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ksef_settings_list" model="ir.ui.view">
        <field name="name">ksef.settings.list</field>
        <field name="model">ksef.settings</field>
        <field name="arch" type="xml">
            <list>
                <field name="public_asymmetric_key_id" column_invisible="True"/>
                <field name="public_asymmetric_key_id_name" column_invisible="True"/>
                <field name="public_symmetric_key_id" column_invisible="True"/>
                <field name="public_symmetric_key_id_name" column_invisible="True"/>

                <field name="name"/>
                <field name="endpoint_url"/>
                <field name="qr_code_url"/>

                <field name="public_asymmetric_key_id_datas" widget="binary" filename="public_asymmetric_key_id_name"/>
                <field name="public_symmetric_key_id_datas" widget="binary" filename="public_symmetric_key_id_name"/>
            </list>
        </field>
    </record>

    <record id="action_ksef_settings" model="ir.actions.act_window">
        <field name="name">KSeF Settings</field>
        <field name="res_model">ksef.settings</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ksef" name="KSeF"
              parent="base.menu_custom"
              sequence="40"/>
    <menuitem id="menu_ksef_settings"
              parent="menu_ksef"
              action="trilab_ksef.action_ksef_settings"/>

</odoo>
