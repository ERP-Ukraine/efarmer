<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="efarmer_sale_report_view_tree" model="ir.ui.view">
        <field name="name">efarmer.sale.report.view.tree</field>
        <field name="model">efarmer.sale.report</field>
        <field name="arch" type="xml">
            <tree>
                <field name="product_code"/>
                <field name="product_id"/>
                <field name="quantity" widget="integer"/>
                <field name="revenue" widget="integer"/>
                <field name="margin" widget="integer"/>
                <field name="country_id"/>
                <field name="sales_person_id"/>
                <field name="invoice_create_date" widget="date"/>
                <field name="invoice_paid_date" widget="date"/>
            </tree>
        </field>
    </record>

    <record id="efarmer_sale_report_action_view_form" model="ir.actions.act_window">
        <field name="name">Sale Report</field>
        <field name="res_model">efarmer.sale.report</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="efarmer_sale_report_view_tree"/>
        <field name="target">current</field>
    </record>

    <menuitem
        name="Sale Report"
        id="efarmer_sale_report_menu"
        action="efarmer_sale_report_action_view_form"
        parent="sale.menu_sale_report"
    />

</odoo>
