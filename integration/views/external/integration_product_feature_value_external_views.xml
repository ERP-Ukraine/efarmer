<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="integration_product_feature_value_external_view_tree" model="ir.ui.view">
            <field name="name">integration.product.feature.value.external.view.list</field>
            <field name="model">integration.product.feature.value.external</field>
            <field name="arch" type="xml">
                <list editable="bottom" create="0">
                    <field name="id" groups="base.group_no_one"/>
                    <field name="integration_id"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="external_feature_id"/>
                    <button name="action_open_mapping"
                            type="object"
                            string="Open Mapping"
                            icon="fa-external-link"
                            class="btn-outline-primary"
                    />
                </list>
            </field>
        </record>

        <record id="integration_product_feature_value_external_view_search" model="ir.ui.view">
            <field name="name">integration.product.feature.value.view.search</field>
            <field name="model">integration.product.feature.value.external</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="external_feature_id"/>
                    <field name="integration_id"/>
                    <group>
                        <filter string="E-Commerce Store" name="group_by_integration_id" context="{'group_by': 'integration_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="integration_product_feature_value_external_action" model="ir.actions.act_window">
            <field name="name">External Feature Values</field>
            <field name="path">eci-external-feature-values</field>
            <field name="res_model">integration.product.feature.value.external</field>
            <field name="view_mode">list</field>
        </record>

    </data>
</odoo>
