<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ecommerce_product_category_form_view" model="ir.ui.view">
        <field name="name">ecommerce.product.category.form</field>
        <field name="model">ecommerce.product.category</field>
        <field name="arch" type="xml">
            <form string="E-Commerce Integration Categories">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_left">
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ecommerce_product_category_tree_view" model="ir.ui.view">
        <field name="name">ecommerce.product.category.list</field>
        <field name="model">ecommerce.product.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="display_name"/>
            </list>
        </field>
    </record>

    <record id="ecommerce_product_category_action" model="ir.actions.act_window">
        <field name="name">E-Commerce Integration Categories</field>
        <field name="path">eci-ecommerce-categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ecommerce.product.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" eval="False"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
            Define a new category
            </p>
            <p>
            Categories are used to classify your products and to help your customers to find them easily.
            </p>
        </field>
    </record>

    <menuitem id="menu_catalog_categories"
              action="ecommerce_product_category_action"
              parent="sale.menu_sale_config"
              sequence="1"/>

</odoo>
