<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="model_product_product_action_force_export_to_external" model="ir.actions.server">
        <field name="name">Export to Stores</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">form,list</field>
        <field name="sequence">10</field>
        <field name="state">code</field>
        <field name="code">action = records.mapped('product_tmpl_id').action_export_to_stores()</field>
    </record>

    <record id="model_product_product_action_force_export_inventory" model="ir.actions.server">
        <field name="name">Export Stock to Stores</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">form,list</field>
        <field name="sequence">20</field>
        <field name="state">code</field>
        <field name="code">action = records.action_force_export_inventory()</field>
    </record>

    <record id="product_product_change_external_integration" model="ir.actions.server">
        <field name="name">Manage Store Connections</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">form,list</field>
        <field name="sequence">30</field>
        <field name="group_ids" eval="[(6, 0, (ref('integration.group_integration_manager'),))]"/>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.change_external_integration_variant()
        </field>
    </record>

    <record id="model_product_product_action_refresh_product_info" model="ir.actions.server">
        <field name="name">Refresh from Store</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">form,list</field>
        <field name="sequence">40</field>
        <field name="state">code</field>
        <field name="code">action = records.mapped('product_tmpl_id').action_run_refresh_product_info_from_external()</field>
    </record>

    <record id="product_product_action_open_related_jobs" model="ir.actions.server">
        <field name="name">View Synchronization History</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">form</field>
        <field name="sequence">50</field>
        <field name="state">code</field>
        <field name="group_ids" eval="[(4, ref('integration.group_integration_manager'))]"/>
        <field name="code">action = records.open_related_jobs()</field>
    </record>

    <record id="product_product_view_form_easy_inherit_integration" model="ir.ui.view">
        <field name="name">product.product</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button"
                    name="action_integration_mappings"
                    type="object"
                    icon="fa-list-ul"
                    help="E-Commerce Store Mappings"
                    invisible="not mapping_count">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="mapping_count" widget="statinfo" nolabel="1" class="mr4"/>
                        </span>
                        <span class="o_stat_text">Store Mappings</span>
                    </div>
                </button>
            </div>

            <sheet position="inside">
                <group name="integrations" string="Stores">
                    <div colspan="2">
                        <div class="alert alert-warning" role="alert"
                            invisible="not integration_company_mismatch">
                            <i class="fa fa-warning" title="Warning"/>
                            <strong>Company mismatch:</strong>
                            this product belongs to another company than the selected e-commerce store(s).
                            This may affect mapping and synchronization.
                        </div>
                    </div>
                    <div class="text-muted" colspan="2">
                        <i class="fa fa-info-circle" title="Information"/>
                        Ticking a store only links this variant to it — nothing is sent yet. Use
                        <strong>Export to Stores</strong> below to publish or update it there. Unticking just removes
                        the link; it does not delete or change the product already in the store.
                    </div>
                    <field name="integration_ids" widget="many2many_checkboxes"/>
                    <div colspan="2" class="mt-2">
                        <button name="action_export_to_stores" type="object" string="Export to Stores"
                                class="btn-outline-primary me-2" icon="fa-cloud-upload" invisible="not id"
                                confirm="This publishes the product to all linked stores now, overwriting their current content and images there. Continue?"
                                help="Publish this product to all linked stores now, overwriting their current content and images there."/>
                        <button name="export_images_to_integration" type="object" string="Export Images Only"
                                class="btn-outline-secondary" context="{'integration_erase_mappings': True}"
                                groups="base.group_no_one" invisible="not id"
                                help="Export only the product images to e-commerce stores without updating other product data"/>
                    </div>
                </group>

                <group name="store_specific_settings_variant">
                    <!-- Content will be added here dynamically based on the selected stores -->
                </group>

                <group name="product_variant_images" string="Extra Variant Media">
                    <div colspan="2">
                        <div class="alert alert-info" role="alert">
                            <p class="mb-0">
                                <i class="fa fa-info-circle" title="Information"/>
                                Add additional images for your product.
                                These will be synchronized to your e-commerce stores to showcase your product.
                            </p>
                        </div>
                    </div>

                    <field name="integration_variant_image_ids"
                           colspan="2"
                           context="{'default_name': name}"
                           mode="kanban"
                           options="{'create_text':'Add Image'}"
                           nolabel="1"
                           widget="x2_many_media_viewer"
                    />
                </group>
            </sheet>

            <xpath expr="//group[@name='pricing']/div" position="after">
                <field name="variant_extra_price" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
            </xpath>
        </field>
    </record>

    <record id="product_normal_form_view_integration" model="ir.ui.view">
        <field name="name">product.product.form.integration</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <div class="alert alert-warning mb-3" role="alert" invisible="not pending_first_export_warning">
                    <i class="fa fa-clock-o" title="Pending"/>
                    This product is waiting to be published to the e-commerce store(s) below. It will be exported
                    automatically once the required fields are filled:
                    <field name="pending_first_export_warning" nolabel="1" readonly="1"/>
                </div>
            </xpath>
            <div name="button_box" position="inside">
                <button class="oe_stat_button"
                    name="action_integration_mappings"
                    type="object"
                    icon="fa-list-ul"
                    help="E-Commerce Store Mappings"
                    invisible="not mapping_count">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="mapping_count" widget="statinfo" nolabel="1" class="mr4"/>
                        </span>
                        <span class="o_stat_text">Store Mappings</span>
                    </div>
                </button>
            </div>
            <div name="list_price_uom" position="after">
                <field name="variant_extra_price" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
            </div>
        </field>
    </record>

    <record model="ir.ui.view" id="product_product_search_view">
        <field name="name">product.product</field>
        <field name="model">product.product</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='all_integrations_set']" position="replace"/>
            <xpath expr="//filter[@name='no_integrations_set']" position="replace"/>
            <xpath expr="//filter[@name='partial_integrations_set']" position="replace"/>
            <xpath expr="//filter[@name='exclude_from_synchronization']" position="replace"/>
            <xpath expr="//filter[@name='exclude_from_synchronization_stock']" position="replace"/>
            <xpath expr="//filter[@name='with_bom']" position="replace"/>
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator/>
                <filter string="With Bill of Materials" name="with_bom" domain="[('bom_ids', '!=', False)]"/>
                <separator/>
                <filter string="Linked to E-Commerce Store(s)" name="integrations_setall_integrations_set" domain="[('integration_ids', '!=', False)]"/>
                <filter string="Not linked to any E-Commerce Store" name="no_integrations_set" domain="[('integration_ids', '=', False)]"/>
                <separator/>
                <filter string="Do not sync with E-Commerce Stores" name="exclude_from_synchronization" domain="[('exclude_from_synchronization', '=', True)]"/>
                <filter string="Do not sync stock with E-Commerce Stores" name="exclude_from_synchronization_stock" domain="[('exclude_from_synchronization_stock', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
