<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_module_filter_inherit_integration" model="ir.ui.view">
        <field name="name">ir.module.module.list.select</field>
        <field name="model">ir.module.module</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="base.view_module_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//group[filter[@name='state']]" position="after">
                <filter string="VentorTech Modules"
                        name="ventortech_modules"
                        domain="[('author', 'ilike', 'VentorTech')]"
                        help="Show only VentorTech modules"/>
            </xpath>
        </field>
    </record>

</odoo>
