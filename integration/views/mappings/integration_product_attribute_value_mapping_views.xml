<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="integration_product_attribute_value_mapping_view_tree" model="ir.ui.view">
            <field name="name">integration.product.attribute.value.mapping.view.list</field>
            <field name="model">integration.product.attribute.value.mapping</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="id" groups="base.group_no_one"/>
                    <field name="integration_id"/> <!-- Required because it is used in the fields domains in the model -->
                    <field name="attribute_id" column_invisible="1"/>  <!-- Required because it is used in the fields domains in the model -->
                    <field name="external_attribute_value_id" domain="[('integration_id', '=', integration_id)]"/>
                    <field name="attribute_value_id" domain="[('attribute_id', '=', attribute_id)]"/>
                    <button type="object"
                            name="run_auto_link"
                            string="Auto-Link"
                            title="Find an existing Odoo attribute value with the same name (within the parent attribute) and link this mapping to it"
                            icon="fa-link"
                            class="btn-outline-primary"
                            invisible="attribute_value_id"/>
                </list>
            </field>
        </record>

        <record id="integration_product_attribute_value_mapping_view_search" model="ir.ui.view">
            <field name="name">integration.product.attribute.value.mapping.view.search</field>
            <field name="model">integration.product.attribute.value.mapping</field>
            <field name="arch" type="xml">
                <search>
                    <field name="attribute_value_id"/>
                    <field name="external_attribute_value_id"/>
                    <field name="integration_id"/>
                    <filter string="Not Mapped" name="not_mapped" domain="[('attribute_value_id', '=', False)]"/>
                    <group>
                        <filter string="E-Commerce Store" name="group_by_integration_id" context="{'group_by': 'integration_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="integration_product_attribute_value_mapping_action" model="ir.actions.act_window">
            <field name="name">Attribute Value Mappings</field>
            <field name="path">eci-attribute-value-mappings</field>
            <field name="res_model">integration.product.attribute.value.mapping</field>
            <field name="view_mode">list</field>
            <field name="context">{'search_default_not_mapped': 1}</field>
        </record>

        <record id="integration_product_attribute_value_mapping_action_show_unmapped" model="ir.actions.server">
            <field name="name">Show Unmapped Objects</field>
            <field name="model_id" ref="integration.model_integration_product_attribute_value_mapping"/>
            <field name="binding_model_id" ref="integration.model_integration_product_attribute_value_mapping"/>
            <field name="binding_view_types">list</field>
            <field name="group_ids" eval="[(4, ref('base.group_no_one'))]"/>
            <field name="state">code</field>
            <field name="code">action = records.show_unmapped_object()</field>
        </record>

        <record id="integration_product_attribute_value_mapping_action_auto_link" model="ir.actions.server">
            <field name="name">Auto-Link</field>
            <field name="model_id" ref="integration.model_integration_product_attribute_value_mapping"/>
            <field name="binding_model_id" ref="integration.model_integration_product_attribute_value_mapping"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="sequence">1</field>
            <field name="code">action = records.run_auto_link()</field>
        </record>

    </data>
</odoo>
