<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="integration_product_product_mapping_view_tree" model="ir.ui.view">
            <field name="name">integration.product.product.mapping.view.list</field>
            <field name="model">integration.product.product.mapping</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="id" groups="base.group_no_one"/>
                    <field name="integration_id"/>
                    <field name="external_product_id" string="E-Commerce Variant" domain="[('integration_id', '=', integration_id)]"/>
                    <field name="product_id" string="Odoo Variant"/>

                    <!-- Debug buttons -->
                    <button type="object"
                            name="calculate_import_fields_data"
                            string="Show Import Data"
                            title="Display raw data that would be imported from e-commerce"
                            icon="fa-code"
                            class="btn-outline-secondary"
                            context="{'integration_return_action': True}"
                            invisible="not external_product_id"
                            groups="base.group_no_one"/>
                    <button type="object"
                            name="calculate_export_data"
                            string="Show Export Data"
                            title="Display raw data that would be exported to e-commerce"
                            icon="fa-code"
                            class="btn-outline-secondary"
                            context="{'integration_return_action': True}"
                            invisible="not product_id"
                            groups="base.group_no_one"/>
                </list>
            </field>
        </record>

        <record id="integration_product_product_mapping_view_search" model="ir.ui.view">
            <field name="name">integration.product.product.mapping.view.search</field>
            <field name="model">integration.product.product.mapping</field>
            <field name="arch" type="xml">
                <search>
                    <field name="product_id"/>
                    <field name="external_product_id"/>
                    <field name="integration_id"/>
                    <filter string="Not Mapped" name="not_mapped" domain="[('product_id', '=', False)]" />
                    <group>
                        <filter string="E-Commerce Store" name="group_by_integration_id" context="{'group_by': 'integration_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="integration_product_product_mapping_action" model="ir.actions.act_window">
            <field name="name">Variant Mappings</field>
            <field name="path">eci-variant-mappings</field>
            <field name="res_model">integration.product.product.mapping</field>
            <field name="view_mode">list</field>
            <field name="context">{'search_default_not_mapped': 1, 'product_product_mapping': 1}</field>
        </record>

        <record id="integration_product_product_mapping_action_show_unmapped" model="ir.actions.server">
            <field name="name">Show Unmapped Objects</field>
            <field name="model_id" ref="integration.model_integration_product_product_mapping"/>
            <field name="binding_model_id" ref="integration.model_integration_product_product_mapping"/>
            <field name="binding_view_types">list</field>
            <field name="group_ids" eval="[(4, ref('base.group_no_one'))]"/>
            <field name="state">code</field>
            <field name="code">action = records.show_unmapped_object()</field>
        </record>

    </data>
</odoo>
