<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_integration" model="ir.module.category">
            <field name="name">E-Commerce Integrations</field>
        </record>

        <record id="res_groups_privilege_integration" model="res.groups.privilege">
            <field name="name">Integration</field>
            <field name="category_id" ref="module_category_integration"/>
            <field name="sequence">1</field>
        </record>

        <record id="group_integration_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_integration"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <!-- TODO: Provide compatibility with Job Queue module -->
            <field name="implied_ids" eval="[(4, ref('integration_queue_job.group_queue_job_manager'))]"/>
        </record>

    </data>
</odoo>
