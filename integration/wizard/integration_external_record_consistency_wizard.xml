<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_integration_external_record_consistency_wizard_form" model="ir.ui.view">
        <field name="name">integration.external.record.consistency.wizard.form</field>
        <field name="model">integration.external.record.consistency.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="integration_type" invisible="1"/>
                    <field name="integration_id" invisible="1"/>
                    <field name="show_variants" invisible="1"/>
                    <field name="line_ids" invisible="1"/>

                    <div class="alert alert-info" role="alert">
                        Check external records stored in Odoo against the current records available
                        in the e-commerce store. Missing rows are usually stale records or mappings
                        that should be reviewed before import/export debugging.
                    </div>

                    <div class="alert alert-info" role="alert" invisible="not line_ids">
                        <strong>Consistency Status Explanation</strong>
                        <br/>
                        <strong class="text-success">Green</strong>
                        - The external record exists in the e-commerce store and mapping structure is valid.
                        <br/>
                        <strong class="text-warning">Yellow</strong>
                        - The external record is not mapped to an Odoo record, or product variants do not match between the store and Odoo.
                        <br/>
                        <strong class="text-danger">Red</strong>
                        - The external record is missing in the e-commerce store and should be reviewed or deleted.
                    </div>

                    <group>
                        <group>
                            <field name="entity_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="checked_count" readonly="1" invisible="not line_ids"/>
                            <field name="missing_count" readonly="1" invisible="not line_ids"/>
                            <field name="unmapped_count" readonly="1" invisible="not line_ids"/>
                            <field name="variant_mismatch_count" readonly="1" invisible="not line_ids"/>
                        </group>
                        <group invisible="not line_ids">
                            <field name="line_status_filter"
                                   widget="radio"
                                   options="{'horizontal': true}"/>
                        </group>
                    </group>

                    <field name="filtered_line_ids" nolabel="1">
                        <list
                            create="0"
                            delete="0"
                            decoration-danger="status == 'missing'"
                            decoration-warning="status in ('unmapped', 'structure_mismatch')"
                            decoration-success="status == 'ok'"
                            decoration-muted="status == 'deleted'"
                        >
                            <field name="status" column_invisible="1"/>
                            <field name="can_delete" column_invisible="1"/>
                            <field name="code" style="min-width: 90px;"/>
                            <field name="external_record_ref" style="min-width: 180px;"/>
                            <field name="external_variant_ids"
                                   widget="many2many_tags"
                                   optional="show"
                                   readonly="1"
                                   style="min-width: 220px;"
                                   column_invisible="not parent.show_variants"/>
                            <field name="odoo_variant_ids"
                                   widget="many2many_tags"
                                   optional="show"
                                   readonly="1"
                                   style="min-width: 220px;"
                                   column_invisible="not parent.show_variants"/>
                            <field name="odoo_record_ref" optional="show" style="min-width: 180px;"/>
                            <field name="odoo_record_id" optional="show" style="min-width: 80px;"/>
                            <button name="action_delete_external_record"
                                    type="object"
                                    string="Delete"
                                    icon="fa-trash"
                                    class="btn-link text-danger"
                                    style="min-width: 70px;"
                                    invisible="not can_delete"
                                    confirm="Delete this external record from Odoo? Dependent mappings may also be removed."/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_check_consistency" type="object" string="Run Consistency Check" class="btn-primary"/>
                    <button name="action_open_missing_records"
                            type="object"
                            string="Open Missing Records"
                            class="btn-secondary"
                            invisible="not missing_count"/>
                    <button name="action_open_unmapped_records"
                            type="object"
                            string="Open Unmapped Records"
                            class="btn-secondary"
                            invisible="not unmapped_count"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
