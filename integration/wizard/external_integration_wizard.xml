<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="change_external_integration_wizard" model="ir.ui.view">
        <field name="name">Manage Store Connections Wizard</field>
        <field name="model">external.integration.wizard</field>
        <field name="arch" type="xml">
            <form string="Manage Store Connections">
                <field name="state" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                    <field name="message" nolabel="1" readonly="1"/>
                    <ul class="mb-0 mt-1">
                        <li><span class="fw-semibold">Link only</span> — connect the products to the store but send nothing.</li>
                        <li><span class="fw-semibold">Link &amp; export now</span> — connect them AND immediately publish/overwrite their content and images in that store. Use with care on live stores.</li>
                        <li><span class="fw-semibold">Unlink</span> — remove the connection only; it does not delete the product already in the store.</li>
                        <li><span class="fw-semibold">No change</span> — leave the store untouched.</li>
                    </ul>
                </div>
                <div class="alert alert-warning" role="alert" invisible="state != 'confirm'">
                    <field name="confirmation_message" nolabel="1" readonly="1"/>
                </div>
                <field name="integration_line_ids" nolabel="1" invisible="state != 'draft'">
                    <list editable="bottom" create="0" delete="0">
                        <field name="integration_id" column_invisible="1"/> <!-- Required because it is used in the fields domains in the model -->
                        <field name="name" string="External Integration"/>
                        <field name="integration_action" required="1"/>
                    </list>
                </field>
                <footer>
                    <button name="apply_integration" string="Apply" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="apply_integration" string="Confirm export" type="object" class="btn-primary"
                            invisible="state != 'confirm'"/>
                    <button name="action_back" string="Back" type="object" class="btn-secondary"
                            invisible="state != 'confirm'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
