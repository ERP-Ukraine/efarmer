#. module: integration
#: model:ir.model.fields,help:integration.field_external_order_transaction__kind
msgid ""
"\n"
"            Payment Authorization: Customer approval to charge their payment "
"method\n"
"                (valid for 7-30 days depending on your payment processor)\n"
"\n"
"            Payment Capture: Transfer of previously authorized funds to your "
"account\n"
"\n"
"            Direct Sale: Immediate authorization and capture in a single "
"transaction\n"
"\n"
"            Transaction Void: Cancellation of a pending authorization or "
"capture\n"
"\n"
"            Payment Refund: Return of captured funds to the customer\n"
"\n"
"            Other Transaction: Any other transaction type not listed above\n"
"        "
msgstr ""
"\n"
"            Autorización de pago: Aprobación del cliente para cobrar su "
"medio de pago\n"
"                (válida por 7 a 30 días, según tu procesador de pagos)\n"
"\n"
"            Captura de pago: Transferencia a tu cuenta de los fondos "
"previamente autorizados\n"
"\n"
"            Venta directa: Autorización y captura inmediatas en una sola "
"transacción\n"
"\n"
"            Anulación de transacción: Cancelación de una autorización o "
"captura pendiente\n"
"\n"
"            Reembolso de pago: Devolución al cliente de los fondos "
"capturados\n"
"\n"
"            Otra transacción: Cualquier otro tipo de transacción no listado "
"arriba\n"
"        "

