msgid ""
"<span class=\"border-start border-warning border-2 d-block ps-2\" "
"name=\"sale-pricelist-warning\">\n"
"                                                    If a product is included "
"in this pricelist, its sale price will be exported to the e-commerce system. "
"If the product is not in the pricelist, an empty value will be sent to clear "
"any existing sale price in the store.\n"
"                                                    Important: Sale prices "
"are never imported from the e-commerce system, even if the product is in "
"this pricelist. This field is for export only.\n"
"                                                </span>"
msgstr ""
"<span class=\"border-start border-warning border-2 d-block ps-2\" "
"name=\"sale-pricelist-warning\">\n"
"                                                    Si un producto está "
"incluido en esta lista de precios, su precio de venta se exportará al "
"sistema de e-commerce. Si el producto no está en la lista de precios, se "
"enviará un valor vacío para limpiar cualquier precio de venta existente en "
"la tienda.\n"
"                                                    Importante: los precios "
"de venta nunca se importan desde el sistema de e-commerce, incluso si el "
"producto está en esta lista de precios. Este campo es solo para "
"exportación.\n"
"                                                </span>"

#. module: integration
#: model_terms:ir.ui.view,arch_db:integration.view_sale_integration_form
msgid ""
"<span class=\"border-start border-warning border-2 d-block ps-2\">\n"
"                                                    When this pricelist is "
"selected, the connector will use prices from it during product export, if a "
"pricelist item exists for the product. Otherwise, the product's default "
"price will be used.\n"
"                                                    Important: Setting a "
"pricelist here prevents product prices from being updated during import. "
"This avoids potential issues where the exported price (from the pricelist) "
"and the actual product price in Odoo differ.\n"
"                                                </span>"
msgstr ""
"<span class=\"border-start border-warning border-2 d-block ps-2\">\n"
"                                                    Cuando se selecciona "
"esta lista de precios, el conector usará sus precios durante la exportación "
"de productos, si existe un ítem de lista de precios para el producto. De lo "
"contrario, se usará el precio predeterminado del producto.\n"
"                                                    Importante: configurar "
"una lista de precios acá evita que los precios de los productos se "
"actualicen durante la importación. Esto evita posibles problemas cuando el "
"precio exportado (desde la lista de precios) y el precio real del producto "
"en Odoo difieren.\n"
"                                                </span>"

