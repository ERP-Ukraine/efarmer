msgstr "Actualizar automáticamente los impuestos según la posición fiscal"

#. module: integration
#: model:ir.model.fields,help:integration.field_integration_sale_order_sub_status_external__validate_picking
msgid "Automatically validate the delivery when this status is reached"
msgstr "Validar automáticamente la entrega cuando se alcance este estado"

