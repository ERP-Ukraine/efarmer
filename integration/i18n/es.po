#. module: integration
#: model:ir.model.fields,help:integration.field_sale_integration__integration_pricelist_id
msgid ""
"Choose the pricelist that will be used to determine product prices during "
"the export process. This is the default pricelist for general product "
"exports.\n"
"\n"
