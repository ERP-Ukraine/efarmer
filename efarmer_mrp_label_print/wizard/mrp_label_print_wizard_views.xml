<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="mrp_label_print_wizard_view_form" model="ir.ui.view">
            <field name="name">mrp.label.print.wizard.form</field>
            <field name="model">mrp.label.print.wizard</field>
            <field name="arch" type="xml">
                <form string="Print Labels">
                    <group>
                        <field name="production_ids" widget="many2many_tags"/>
                        <field name="label_type"/>
                        <field name="total_label_qty"/>
                        <field name="is_multi_production" invisible="1"/>
                    </group>
                    <div class="text-warning mb-2">Lines highlighted in orange have no quant, labels are not printed for them.</div>
                    <field name="line_ids">
                        <list editable="bottom" create="false" decoration-info="quant_id and line_type == 'finished'" decoration-warning="not quant_id">
                            <field name="production_id" column_invisible="not parent.is_multi_production"/>
                            <field name="line_type"/>
                            <field name="product_id"/>
                            <field name="lot_id" optional="show"/>
                            <field name="location_id" optional="show"/>
                            <field name="quant_id" optional="show"/>
                            <field name="quantity"/>
                            <field name="product_uom_id" groups="uom.group_uom" optional="show"/>
                            <field name="label_type" readonly="not quant_id"/>
                            <field name="label_qty" readonly="not quant_id"/>
                        </list>
                    </field>
                    <footer>
                        <button string="Print" name="action_print" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
