<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">hubspot.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="quotation_order_setting_container" position="inside">
                <setting id="sale_hubspot">
                    <field name="use_sale_hubspot_connector"/>
                    <field name="sale_hubspot_config_id" invisible="not use_sale_hubspot_connector"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>

