<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_cancel_restrict" model="ir.ui.view">
        <field name="name">account.move.form.inherit.cancel.restrict</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="restrict_customer_invoice_cancel" invisible="1"/>
            </xpath>
            <!-- "Cancel" on invoices/bills (the "Cancel Entry" button is for misc. entries and is untouched). -->
            <xpath expr="//header/button[@name='button_cancel'][contains(@invisible, &quot;move_type == 'entry'&quot;)]" position="attributes">
                <attribute name="invisible" add="restrict_customer_invoice_cancel" separator=" or "/>
            </xpath>
            <xpath expr="//header/button[@name='button_request_cancel']" position="attributes">
                <attribute name="invisible" add="restrict_customer_invoice_cancel" separator=" or "/>
            </xpath>
        </field>
    </record>
</odoo>
