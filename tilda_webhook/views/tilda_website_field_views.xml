<?xml version='1.0' encoding='utf-8'?>
<odoo>

<record id="tilda_website_field_view_form" model="ir.ui.view">
    <field name="name">tilda.website.field.view.form</field>
    <field name="model">tilda.website.field</field>
    <field name="arch" type="xml">
        <form string="Tilda Website Field">
            <sheet>
                <group name="base">
                    <field name="tilda_field"/>
                    <field name="odoo_field_id"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="tilda_website_field_view_tree" model="ir.ui.view">
    <field name="name">tilda.website.field.view.tree</field>
    <field name="model">tilda.website.field</field>
    <field name="arch" type="xml">
        <tree string="Tilda Website Fields">
            <field name="tilda_field"/>
            <field name="odoo_field_id"/>
        </tree>
    </field>
</record>

</odoo>
