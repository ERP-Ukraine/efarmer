<?xml version='1.0' encoding='utf-8'?>
<odoo>

<record id="tilda_website_view_form" model="ir.ui.view">
    <field name="name">tilda.website.view.form</field>
    <field name="model">tilda.website</field>
    <field name="arch" type="xml">
        <form string="Tilda Website">
            <sheet>
                <group name="base">
                    <field name="host"/>
                </group>
                <notebook>
                    <page name="fields_mapping" string="Fields Mapping">
                        <field name="field_ids"/>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
</record>

<record id="tilda_website_view_tree" model="ir.ui.view">
    <field name="name">tilda.website.view.tree</field>
    <field name="model">tilda.website</field>
    <field name="arch" type="xml">
        <tree string="Tilda Websites">
            <field name="host"/>
        </tree>
    </field>
</record>

<record id="tilda_website_action" model="ir.actions.act_window">
    <field name="name">Tilda Websites</field>
    <field name="res_model">tilda.website</field>
    <field name="view_mode">tree,form</field>
</record>

</odoo>
