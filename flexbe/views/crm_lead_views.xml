<?xml version='1.0' encoding='utf-8'?><odoo>

<record id="crm_lead_view_form" model="ir.ui.view">
    <field name="name">crm.lead.view.form</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
        <!-- the opportunity page -->
        <xpath expr="//page[@name='extra']//field[@name='campaign_id']" position="before">
            <field name="from_flexbe" attrs="{'invisible': [('from_flexbe', '=', False)]}"/>
        </xpath>
        <!-- the lead page -->
        <xpath expr="//page[@name='lead']//field[@name='campaign_id']" position="before">
            <field name="from_flexbe" attrs="{'invisible': [('from_flexbe', '=', False)]}"/>
        </xpath>
    </field>
</record>

</odoo>
