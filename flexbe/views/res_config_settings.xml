<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
    <field name="arch" type="xml">
        <xpath expr="//div[@data-key='crm']" position="inside">
            <h2>Flexbe</h2>
            <div name="flexbe" class="row mt16 o_settings_container">
                <div class="col-12 col-lg-6 o_setting_box" id="flexbe_lead_type">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="config_flexbe_lead_type"/>
                        <div class="mt8"><field name="config_flexbe_lead_type"/></div>
                        <div class="text-muted">The initial state of new leads from Flexbe.</div>
                    </div>
                </div>
            </div>
        </xpath>
    </field>
</record>

</odoo>
