<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="helpdesk_ticket_view_form" model="ir.ui.view">
    <field name="name">helpdesk.ticket.form</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk_stock.helpdesk_ticket_view_form_inherit_helpdesk_stock"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='partner_email']" position="after">
            <field name="efarmer_client_type"/>
        </xpath>
        <xpath expr="//field[@name='sale_order_id']" position="after">
            <field name="use_fsm" invisible="1"/>
            <field name="use_coupons" invisible="1"/>
        <field name="sale_order_id"
          attrs="{'invisible': [
          ('use_credit_notes', '=', False),
          ('use_product_returns', '=', False),
          ('use_product_repairs', '=', False),
          ('use_fsm', '=', False),
          ('use_coupons', '=', False),
          ]}"/>
        </xpath>
      </field>
</record>

<record id="helpdesk_ticket_view_kanban" model="ir.ui.view">
    <field name="name">helpdesk.ticket.kanban</field>
    <field name="model">helpdesk.ticket</field>
    <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_kanban"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='commercial_partner_id']/.." position="after">
            <div><field name="efarmer_client_type"/></div>
        </xpath>
    </field>
</record>

</odoo>
