<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="stock_production_lot_view_form" model="ir.ui.view">
    <field name="name">stock.production.lot.view.form.inherit</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
        <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
            <button name="action_view_helpdesk_tickets" type="object" class="oe_stat_button" icon="fa-life-ring"
               invisible="helpdesk_tickets_count == 0">
                <field name="helpdesk_tickets_count" string="Tickets" widget="statinfo"/>
            </button>
        </xpath>
    </field>
</record>

</odoo>
