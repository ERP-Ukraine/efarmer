<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_view_kanban" model="ir.ui.view">
        <field name="name">mail.activity.kanban</field>
        <field name="model">mail.activity</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="summary"/>
                <field name="res_name"/>
                <field name="activity_type_id"/>
                <field name="activity_category"/>
                <field name="user_id"/>
                <field name="date_deadline"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-summary">
                        <div class="oe_group_description" t-if="record.summary.raw_value">
                            <field name="summary"/>
                        </div>
                    </t>
                    <t t-name="kanban-box">
                        <div class="oe_module_vignette oe_kanban_global_click d-flex align-items-center">
                            <div class="oe_module_desc">
                                <div class="o_kanban_record_title oe_kanban_details">
                                    <h4><field name="res_name"/></h4>
                                </div>
                                <p class="oe_module_name">
                                    <field name="summary"/>

                                </p>
                                <span>Date deadline:
                                    <span>
                                        <field name="date_deadline"/>
                                    </span>
                                </span>
                                <div class="oe_kanban_footer">
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <h4>
                                                <field name="activity_type_id"/>
                                            </h4>

                                            <field name="state" widget="badge" decoration-success="state == 'planned'"
                                                   decoration-warning="state == 'today'"
                                                   decoration-danger="state == 'overdue'"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="user_id" widget="many2one_avatar_user"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="efarmer_mail_activity_view_search_inherit" model="ir.ui.view">
        <field name="name">mail.activity.view.search.inherit</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='res_model']" position="before">
                <field name="user_id"/>
            </xpath>
            <xpath expr="//filter[@name='activittype']" position="after">
                <filter string="Assigned To Me" name="assigned_to_me" domain="[('user_id','=',uid)]"/>
                <filter string="User" name="user" context="{'group_by': 'user_id'}"/>
                <filter string="Model" name="model" context="{'group_by': 'res_model'}"/>
            </xpath>
        </field>
    </record>

    <record id="efarmer_mail_activity_view_tree_inherit" model="ir.ui.view">
            <field name="name">efarmer.mail.activity.view.tree.inherit</field>
            <field name="model">mail.activity</field>
            <field name="inherit_id" ref="mail.mail_activity_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='summary']" position="after">
                    <field name="user_id" optional="show"/>
                    <button name="action_open_document" type="object" string="Document"/>
                </xpath>
            </field>
        </record>

    <record id="efarmer_action_mail_activity" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">tree,form,kanban,calendar</field>
        <field name="context">
            {'search_default_assigned_to_me': 1}
        </field>
    </record>

    <record id="mail_activity_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="mail.mail_activity_view_form"/>
        <field name="act_window_id" ref="efarmer_action_mail_activity"/>
    </record>

    <record id="mail_activity_action_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="act_window_id" ref="efarmer_action_mail_activity"/>
    </record>

    <record id="mail_activity_action_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">kanban</field>
        <field name="act_window_id" ref="efarmer_action_mail_activity"/>
    </record>

    <menuitem name="Activities" id="menu_mail_activity_root" sequence="10"
              web_icon="efarmer_activities,static/description/icon.png"/>

    <menuitem action="efarmer_action_mail_activity" id="menu_mail_activity" parent="menu_mail_activity_root"
              sequence="135"/>

</odoo>