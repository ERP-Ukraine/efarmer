<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_task_form_inherit_asset" model="ir.ui.view">
            <field name="name">project.task.form.asset</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='project_id']" position="after">
                    <field name="asset_id" invisible="1"/>
                </xpath>

            </field>
        </record>
        <record id="view_account_analytic_line_tree_inherit_efarmer" model="ir.ui.view">
            <field name="name">account.analytic.line.tree.inherit</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="is_paid"/>
                    <field name="epic_id"/>
                    <field name="name_pl"/>
                    <field name="product_version_id"/>
                    <field name="rate_per_hour"/>
                </xpath>
            </field>
        </record>

        <record id="timesheet_grid_pivot_view_inherit" model="ir.ui.view">
            <field name="name">account.analytic.line.pivot.timesheet_grid</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.view_hr_timesheet_line_pivot"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='unit_amount']" position="after">
                    <field name="capital_labour_cost" type="measure" />
                    <field name="capital_unit_amount" type="measure" widget="timesheet_uom" />
                    <field name="percent_capital_labour_cost" type="measure" widget="percentage" />
                    <field name="rate_per_hour" />
                    <field name="amount_eur" />
                    <field name="task_product_id" />
                </xpath>
                <xpath expr="//field[@name='amount']" position="attributes">
                    <attribute name="type">measure</attribute>
                </xpath>
            </field>
        </record>
        <record id="timesheet_report_search_inherit" model="ir.ui.view">
            <field name="name">timesheet_action_billing_report.report.search.inherit</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_report_search"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='task_id']" position="after">
                    <field name="task_product_id" />
                    <field name="epic_id" />
                    <field name="name_pl" />
                    <field name="product_version_id" />
                    <field name="issue_type_id" />
                </xpath>
            </field>
        </record>

        <record id="timesheet_view_search_inherit" model="ir.ui.view">
            <field name="name">account.analytic.line.search.inherit</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_search"/>
            
            <field name="arch" type="xml">
                <xpath expr="//field[@name='task_id']" position="after">
                    <field name="task_product_id" />
                    <field name="epic_id" />
                    <field name="name_pl" />
                    <field name="product_version_id" />
                    <field name="issue_type_id" />
                </xpath>
                <xpath expr="//filter[@name='groupby_employee']" position="after">
                    <filter string="Product - Asset" name="groupby_task_product_id" domain="[]" context="{'group_by': 'task_product_id'}" />
                    <filter string="Epic Task" name="groupby_epic_id" domain="[]" context="{'group_by': 'epic_id'}" />
                    <filter string="Name PL" name="groupby_name_pl" domain="[]" context="{'group_by': 'name_pl'}" />
                    <filter string="Product Version" name="groupby_product_version_id" domain="[]" context="{'group_by': 'product_version_id'}" />
                    <filter string="Issue Type" name="groupby_issue_type_id" domain="[]" context="{'group_by': 'issue_type_id'}" />
                </xpath>
                <xpath expr="//filter[@name='month']" position="before">
                    <filter name="paid" string="Paid" domain="[('is_paid', '=', True)]" />
                    <filter name="capitalized" string="Capitalized" domain="[('is_capitalized', '=', True)]" />
                    <filter name="not_paid_not_capitalized" string="Not Capitalized/Not Paid" domain="[('is_paid', '=', False),('is_capitalized', '=', False)]" />
                    <separator/>
                </xpath>

            </field>
        </record>

        <record id="timesheet_action_timesheet_report" model="ir.actions.act_window">
            <field name="name">Timesheet Report</field>
            <field name="res_model">account.analytic.line</field>
            <field name="domain">[('project_id', '!=', False)]</field>
            <field name="context">{'search_default_groupby_project': 1}</field>
            <field name="search_view_id" ref="hr_timesheet.hr_timesheet_line_search"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                No activities found
              </p><p>
                Track your working hours by projects every day and invoice this time to your customers.
              </p>
            </field>
        </record>

        <record id="timesheet_action_view_timesheet_report_grid" model="ir.actions.act_window.view">
            <field name="sequence" eval="5"/>
            <field name="view_mode">grid</field>
            <field name="view_id" ref="timesheet_grid.timesheet_view_grid_by_project"/>
            <field name="act_window_id" ref="timesheet_action_timesheet_report"/>
        </record>

        <record id="timesheet_action_view_timesheet_report_pivot" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="hr_timesheet.view_hr_timesheet_line_pivot"/>
            <field name="act_window_id" ref="timesheet_action_timesheet_report"/>
        </record>

        <record id="timesheet_action_view_timesheet_report_graph" model="ir.actions.act_window.view">
            <field name="sequence" eval="6"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="hr_timesheet.view_hr_timesheet_line_graph"/>
            <field name="act_window_id" ref="timesheet_action_timesheet_report"/>
        </record>

        <record id="timesheet_action_view_timesheet_report_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
            <field name="act_window_id" ref="timesheet_action_timesheet_report"/>
        </record>

        <record id="timesheet_action_view_timesheet_report_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="15"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="hr_timesheet.hr_timesheet_line_form"/>
            <field name="act_window_id" ref="timesheet_action_timesheet_report"/>
        </record>

        <record id="timesheet_action_view_timesheet_report_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="20"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="hr_timesheet.view_kanban_account_analytic_line"/>
            <field name="act_window_id" ref="timesheet_action_timesheet_report"/>
        </record>

        <menuitem id="project_menu_report_timesheet_report"
            parent="project.menu_project_report"
            action="efarmer_timesheet.timesheet_action_timesheet_report"
            name="Timesheet Report"
            sequence="20"/>

    </data>
</odoo>
