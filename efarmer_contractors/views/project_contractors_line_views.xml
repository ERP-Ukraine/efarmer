<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_project_contractors_line_form" model="ir.ui.view">
        <field name="name">project.contractors.line.form</field>
        <field name="model">project.contractors.line</field>
        <field name="arch" type="xml">
            <form string="Contractors Line">
                <group>
                    <field name="employee_id"/>
                    <field name="description"/>
                    <field name="hours_spent"/>
                    <field name="contract_pay_rate"/>
                    <field name="bamboo_currency_id"/>
                    <field name="amount"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_project_contractors_line_tree" model="ir.ui.view">
        <field name="name">project.contractors.line.tree</field>
        <field name="model">project.contractors.line</field>
        <field name="arch" type="xml">
            <tree string="Contractors Lines">
                <field name="employee_id"/>
                <field name="description"/>
                <field name="hours_spent"/>
                <field name="contract_pay_rate"/>
                <field name="bamboo_currency_id"/>
                <field name="amount"/>
            </tree>
        </field>
    </record>
    <record id="action_view_project_contractors_line" model="ir.actions.act_window">
        <field name="name">Contractors Lines</field>
        <field name="res_model">project.contractors.line</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new contractors line.
            </p>
        </field>
    </record>

</odoo>

