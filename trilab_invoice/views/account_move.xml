<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">trilab_invoice account.view_move_form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <button name="action_reverse" position="after">
                <field name="x_final_source_id" invisible="True"/>
                <field name="x_use_ti" invisible="True"/>
                <button name="action_recalculate_advance_payment" string="Recalculate Downpayment"
                        type='object' groups="account.group_account_invoice"
                        invisible="(state != 'draft') or not x_use_ti or not x_final_source_id"/>
                <button name="x_action_reverse_pl" string="Add Credit Note PL"
                        type='object' groups="account.group_account_invoice"
                        invisible="(move_type != 'in_invoice' and x_correction_invoices_len != 0) or not x_use_ti or (move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'out_receipt'))"/>
            </button>

            <button name="action_reverse" position="attributes">
                <attribute name="invisible">move_type not in (
                    'out_invoice', 'in_invoice') or state != 'posted' or x_use_ti</attribute>
            </button>

            <xpath expr="//div[hasclass('oe_title')]//field[@name='move_type']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]//field[@name='move_type']" position="after">
                <field name="type_name" invisible="move_type == 'entry'" readonly="True" nolabel="1"/>
            </xpath>

            <xpath expr="//field[@name='invoice_date'][2]" position="after">
                <field name="x_invoice_sale_date" readonly="state != 'draft'" invisible="not x_use_ti"/>
                <field name="x_invoice_duplicate_date"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt', 'in_invoice', 'in_receipt') or not x_use_ti"/>
                <field name="x_show_currency_rate" invisible="True"/>
                <field name="x_invoice_currency_rate" string="Currency Rate" digits="[12,4]"
                       invisible="not x_use_ti or not x_show_currency_rate" readonly="state != 'draft'"/>
            </xpath>

            <xpath expr="//field[@name='invoice_currency_rate']" position="attributes">
                <attribute name="digits">[12,4]</attribute>
            </xpath>

            <div name="currency_conversion_div" position="after">
                <div name="x_currency_conversion_div"
                     class="d-flex text-muted float-start"
                     invisible="not x_use_ti or currency_id == company_currency_id">
                    <span>1 </span>
                    <field name="currency_id" readonly="True" options="{'no_open': True}"/>
                    <span> = </span>
                    <field name="x_invoice_currency_rate" digits="[12,4]" readonly="True"/>
                    <span>&amp;nbsp;</span>
                    <field name="company_currency_id" readonly="True" options="{'no_open': True}"/>
                </div>
            </div>

            <field name="ref" position="after">
                <field name="reversed_entry_id" string="Corrected Invoice" readonly="True"
                       invisible="not reversed_entry_id"/>
            </field>

            <div name="button_box" position="inside">
                <field name="x_correction_invoices_len" invisible="True"/>
                <button name="x_view_correction_invoices_action" class="oe_stat_button" icon="fa-bars" type="object"
                        invisible="x_correction_invoices_len == 0">
                    <field name="x_correction_invoices_len" string="Correction Invoices" widget="statinfo"/>
                </button>
            </div>

            <page id="invoice_tab" position="before">
                <page id="invoice_tab_corrected" string="Lines After"
                      invisible="not x_use_ti or move_type in ('entry', 'in_refund') or not reversed_entry_id">
                    <field name="x_corrected_invoice_line_ids"
                           widget="section_and_note_one2many"
                           mode="list,kanban"
                           context="{
                             'default_x_is_corrected_line': True,
                             'default_move_type': context.get('default_move_type'),
                             'journal_id': journal_id,
                             'default_partner_id': commercial_partner_id,
                             'default_currency_id': currency_id or company_currency_id,
                             'default_display_type': 'product',
                             'quick_encoding_vals': quick_encoding_vals,
                             'default_x_quantity': 1,
                         }"
                           readonly="state != 'draft'">
                        <list editable="bottom" string="Journal Items" default_order="sequence, id">
                            <control>
                                <create name="add_line_control" string="Add a line"/>
                                <create name="add_section_control" string="Add a section"
                                        context="{'default_display_type': 'line_section'}"/>
                                <create name="add_note_control" string="Add a note"
                                        context="{'default_display_type': 'line_note'}"/>
                            </control>

                            <!-- Displayed fields -->
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"
                                   optional="show"
                                   domain="context.get('default_move_type') in ('out_invoice', 'out_refund', 'out_receipt')
                                         and [('sale_ok', '=', True), ('company_id', 'in', (False, parent.company_id))]
                                         or [('purchase_ok', '=', True), ('company_id', 'in', (False, parent.company_id))]
                                        "/>
                            <field name="name" widget="section_and_note_text" optional="show"
                                   required="parent.move_type not in ('in_invoice', 'in_receipt')"/>
                            <field name="account_id"
                                   context="{'partner_id': partner_id, 'move_type': parent.move_type}"
                                   groups="account.group_account_readonly"
                                   options="{'no_quick_create': True}"
                                   domain="[('deprecated', '=', False), ('account_type', 'not in', ('asset_receivable', 'liability_payable', 'off_balance'))]"
                                   required="display_type not in ['line_note', 'line_section']"/>

                            <field name="analytic_distribution" widget="analytic_distribution"
                                   groups="analytic.group_analytic_accounting"
                                   optional="show"
                                   options="{'product_field': 'product_id', 'account_field': 'account_id', 'amount_field': 'price_subtotal'}"
                                   business_domain_compute="parent.move_type in ['out_invoice', 'out_refund', 'out_receipt'] and 'invoice' or parent.move_type in ['in_invoice', 'in_refund', 'in_receipt'] and 'bill' or 'general'"/>

                            <field name="quantity"
                                   column_invisible="True"/> <!-- on correction replaced by x_quantity_reverse -->
                            <field name="x_quantity" string="Quantity"/>

                            <field name="product_uom_category_id" column_invisible="True"/>
                            <field name="product_uom_id" string="UoM" groups="uom.group_uom" optional="show"/>

                            <field name="price_unit" string="Price"/>

                            <field name="discount" string="Disc.%" optional="hide"/>

                            <field name="tax_ids" widget="many2many_tags"
                                   domain="[('type_tax_use', '=?', parent.invoice_filter_type_domain), ('company_id', 'parent_of', parent.company_id), ('country_id', '=', parent.tax_country_id)]"
                                   context="{'append_type_to_tax_name': not parent.invoice_filter_type_domain, 'active_test': True}"
                                   options="{'no_create': True}"
                                   optional="show"/>

                            <field name="price_total"
                                   string="Tax incl."
                                   column_invisible="parent.tax_calculation_rounding_method == 'round_globally'"
                                   optional="hide"/>

                            <!-- this replaces price_subtotal -->
                            <field name="price_subtotal" string="Tax excl." column_invisible="True"/>
                            <field name="x_price_subtotal" string="Subtotal"/>

                            <!-- this replaces price_total -->
                            <field name="price_total"
                                   string="Tax incl."
                                   column_invisible="True"/>
                            <field name="x_price_total"
                                   string="Tax incl."
                                   column_invisible="parent.tax_calculation_rounding_method == 'round_globally'"
                                   optional="hide"/>

                            <!-- Other fields -->
                            <field name="partner_id" column_invisible="True"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="company_id" column_invisible="True"/>
                            <field name="company_currency_id" column_invisible="True"/>
                            <field name="display_type" force_save="True" column_invisible="True"/>
                            <field name="move_name" column_invisible="True"/>
                            <field name="x_is_corrected_line" column_invisible="True"/>
                            <field name="product_uom_id" column_invisible="True"/>
                            <field name="x_force_print" optional="hide"/>
                        </list>

                        <form>
                            <sheet>
                                <field name="display_type" invisible="True"/>
                                <field name="company_id" invisible="True"/>
                                <field name="partner_id" invisible="True"/>

                                <field name="product_uom_category_id" invisible="True"/>
                                <field name="parent_state" invisible="True"/>

                                <group>
                                    <field name="product_id" widget="many2one_barcode"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_category_id" invisible="True"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="price_unit"/>
                                    <field name="discount" string="Disc.%"/>
                                </group>

                                <group>
                                    <field name="account_id" options="{'no_create': True}"
                                           context="{'partner_id': partner_id, 'move_type': parent.move_type}"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="analytic_distribution" widget="analytic_distribution"
                                           groups="analytic.group_analytic_accounting"/>
                                </group>
                                <label for="name" string="Description"
                                       invisible="display_type in ['line_note', 'line_section']"/>
                                <label for="name" string="Section" invisible="display_type != 'line_section'"/>
                                <label for="name" string="Note" invisible="display_type != 'line_note'"/>
                                <field name="name" widget="text"/>
                                <group>
                                    <field name="price_subtotal" string="Tax excl."/>
                                    <field name="price_total"
                                           string="Tax incl."
                                           column_invisible="parent.tax_calculation_rounding_method == 'round_globally'"
                                           optional="hide"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                    <div>Change only those lines that should be corrected</div>
                </page>

                <page id="invoice_tab_original" string="Lines Before"
                      invisible="not x_use_ti or move_type in ('entry', 'in_refund') or not reversed_entry_id">
                    <field name="x_original_invoice_line_ids" widget="section_and_note_one2many" mode="list,kanban">
                        <list editable="bottom" string="Journal Items" default_order="sequence, id">

                            <!-- Displayed fields -->
                            <field name="sequence" widget="handle"/>
                            <field name="product_id"
                                   optional="show"
                                   domain="context.get('default_move_type') in ('out_invoice', 'out_refund', 'out_receipt')
                                        and [('sale_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]
                                        or [('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]
                               "/>

                            <field name="name" widget="section_and_note_text" optional="show"/>
                            <field name="account_id"
                                   context="{'partner_id': partner_id, 'move_type': parent.move_type}"
                                   groups="account.group_account_readonly"
                                   options="{'no_create': True}"
                                   required="display_type not in ['line_note', 'line_section']"
                                   domain="[('deprecated', '=', False), ('account_type', 'not in', ('asset_receivable', 'liability_payable')), ('account_type', '!=', 'off_balance')]"/>
                            <field name="analytic_distribution" widget="analytic_distribution"
                                   groups="analytic.group_analytic_accounting"
                                   optional="show"
                                   options="{'product_field': 'product_id', 'account_field': 'account_id'}"
                                   business_domain_compute="parent.move_type in ['out_invoice', 'out_refund', 'out_receipt'] and 'invoice' or parent.move_type in ['in_invoice', 'in_refund', 'in_receipt'] and 'bill' or 'general'"/>

                            <field name="quantity" string="Quantity" optional="show"/>

                            <field name="product_uom_category_id" invisible="True"/>
                            <field name="product_uom_id" string="UoM" groups="uom.group_uom" optional="show"/>

                            <field name="price_unit" string="Price"/>

                            <field name="discount" string="Disc.%" optional="hide"/>
                            <field name="tax_ids" widget="many2many_tags"
                                   domain="[('type_tax_use', '=?', parent.invoice_filter_type_domain), ('company_id', '=', parent.company_id), ('country_id', '=', parent.tax_country_id)]"
                                   context="{'append_type_to_tax_name': not parent.invoice_filter_type_domain}"
                                   options="{'no_create': True}"
                                   optional="show"/>

                            <field name="price_subtotal" string="Tax excl."/>
                            <field name="price_total"
                                   string="Tax incl."
                                   column_invisible="parent.tax_calculation_rounding_method == 'round_globally'"
                                   optional="hide"/>


                            <!-- Others fields -->
                            <field name="partner_id" invisible="True"/>
                            <field name="currency_id" invisible="True"/>
                            <field name="company_id" invisible="True"/>
                            <field name="company_currency_id" invisible="True"/>
                            <field name="display_type" force_save="True" invisible="True"/>
                            <!-- /l10n_in_edi.test_edi_json -->
                            <!-- required for @api.onchange('product_id') -->
                            <field name="product_uom_id" invisible="True"/>
                            <field name="x_force_print" optional="hide"/>
                        </list>

                        <form>
                            <sheet>
                                <field name="display_type" invisible="True"/>
                                <field name="company_id" invisible="True"/>
                                <field name="partner_id" invisible="True"/>
                                <group>
                                    <field name="product_id" widget="many2one_barcode"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_category_id" invisible="True"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="price_unit"/>
                                    <field name="discount" string="Disc.%"/>
                                </group>
                                <group>
                                    <field name="account_id" options="{'no_create': True}"
                                           context="{'partner_id': partner_id, 'move_type': parent.move_type}"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="analytic_distribution" widget="analytic_distribution"
                                           groups="analytic.group_analytic_accounting"/>
                                </group>
                                <label for="name" string="Description"
                                       invisible="display_type in ['line_note', 'line_section']"/>
                                <label for="name" string="Section" invisibe="display_type != 'line_section'"/>
                                <label for="name" string="Note" invisible="display_type != 'line_note'"/>
                                <field name="name" widget="text"/>
                                <group>
                                    <field name="price_subtotal" string="Tax excl."/>
                                    <field name="price_total"
                                           string="Tax incl."
                                           column_invisible="parent.tax_calculation_rounding_method == 'round_globally'"
                                           optional="hide"/>

                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </page>

            <xpath expr="//field[@name='invoice_line_ids']/list" position="inside">
                <field name="x_force_print" optional="hide"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']/list" position="inside">
                <field name="x_force_print" column_invisible="True"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='quantity']" position="attributes">
                <attribute name="column_invisible">parent.move_type == 'out_refund'</attribute>
                <attribute name="optional"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='quantity']" position="after">
                <field name="x_quantity" string="Quantity" column_invisible="parent.move_type != 'out_refund'"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">parent.move_type == 'out_refund'</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='price_subtotal']" position="after">
                <field name="x_price_subtotal" string="Subtotal" column_invisible="parent.move_type != 'out_refund'"/>
            </xpath>

            <field name="invoice_line_ids" position="attributes">
                <attribute name="readonly">(state != 'draft') or (x_use_ti and reversed_entry_id and move_type != 'in_refund')</attribute>
            </field>

            <xpath expr="//field[@name='ref']" position="attributes">
                <attribute name="invisible">move_type == 'entry'</attribute>
            </xpath>

            <xpath expr="//label[@for='ref']" position="replace">
                <label for="ref" string="Reference"
                       invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
                <label for="ref" string="Invoice Number"
                       invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
            </xpath>

            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="currency_id"
                       readonly="state != 'draft'"
                       invisible="move_type != 'entry'"
                       groups="base.group_multi_currency"
                       options="{'no_create': True}"/>
            </xpath>

            <xpath expr="//field[@name='line_ids']//list" position="inside">
                <field name="currency_rate" optional="hide" digits="[12,12]"/>
            </xpath>

<!--
            <xpath expr="//field[@name='line_ids']//field[@name='balance']" position="attributes">
                <attribute name="force_save">True</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']//field[@name='debit']" position="attributes">
                <attribute name="force_save">True</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']//field[@name='credit']" position="attributes">
                <attribute name="force_save">True</attribute>
            </xpath>
-->

        </field>
    </record>


    <record id="view_out_invoice_tree" model="ir.ui.view">
        <field name="name">trilab_invoice account.out.invoice.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="currency_id" optional="show"/>
                <field name="x_amount_total" optional="hide"/>
                <field name="x_amount_residual" string="To Pay in Currency" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_in_invoice_tree" model="ir.ui.view">
        <field name="name">trilab_invoice account.in.invoice.list</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="currency_id" optional="show"/>
                <field name="x_amount_total" optional="hide"/>
                <field name="x_amount_residual" string="To Pay in Currency" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
